        xmlns:controls="clr-namespace:ZusiStart.Controls"
        Title="Gleisbelegung"
        Width="1200"
        Height="800"
        Background="#1E1E1E">

  
    <DockPanel>

      <Menu DockPanel.Dock="Top">
