<Window x:Class="ZusiStart.Dialogs.WebView_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZusiStart.Dialogs"
        xmlns:WpF="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="ZusiStart WebView" Height="800" Width="1600">
    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border x:Name="brdMainWeb" Visibility="{Binding MainWebBorderVisibility, ElementName=window}"  Background="{DynamicResource Blue.Transparent.Background}"/>
    <StackPanel Orientation="Horizontal" Grid.Row="0">
      <Button Name="backButton" Content="←" Click="BackButton_Click" Width="30" Height="30"/>
      <Button Name="forwardButton" Content="→" Click="ForwardButton_Click" Width="30" Height="30"/>
      <TextBox Name="urlTextBox" IsReadOnly="True" Background="Transparent" Foreground="White" BorderThickness="0" VerticalAlignment="Center"/>
    </StackPanel>
    <WpF:WebView2 Name="webViewWin" Grid.Row="1" NavigationCompleted="WebView_NavigationCompleted" SourceChanged = "CoreWebView2SourceChanged"/>
    

  </Grid>
</Window>
