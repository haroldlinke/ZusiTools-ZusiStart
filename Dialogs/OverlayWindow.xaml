<Window x:Class="ZusiStart.Dialogs.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cv="clr-namespace:ZusiStart.Converter"
        xmlns:local="clr-namespace:ZusiStart.Dialogs"
        mc:Ignorable="d"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True">
  <Window.Resources>

    <cv:HalfValueConverter x:Key="HalfValueConverter"/>
  </Window.Resources>
  <Grid>
    <Canvas Name="overlayCanvas" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}">

      <!-- Horizontale Linie -->
      <Line X1="0" Y1="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HalfValueConverter}}"
          X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}" 
          Y2="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HalfValueConverter}}"
          Stroke="Red" StrokeThickness="2"/>

      <!-- Vertikale Linie -->
      <Line X1="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HalfValueConverter}}" 
          Y1="0" 
          X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HalfValueConverter}}" 
          Y2="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}" 
          Stroke="Red" StrokeThickness="2"/>

      <!-- Kreis -->
      <Ellipse Width="30" Height="30" Stroke="Red" StrokeThickness="2"
             Canvas.Left="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HalfValueConverter},ConverterParameter=15}"
             Canvas.Top="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HalfValueConverter},ConverterParameter=15}"/>
    </Canvas>
  </Grid>
  </Window>

