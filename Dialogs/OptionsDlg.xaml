<Window x:Class="ZusiStart.Dialogs.OptionsDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZusiStart.Dialogs"
        mc:Ignorable="d"
        Title="Optionen" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Background="{x:Null}" UseLayoutRounding="True" SnapsToDevicePixels="True" ShowInTaskbar="False" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" MinHeight="400">

  <Border BorderBrush="Gold" BorderThickness="6,2" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,0,12,24" CornerRadius="12" Background="{DynamicResource Bright.Transparent.Background}" MinWidth="450">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Grid.ColumnSpan="2" Background="{StaticResource Blue.Transparent.Background}" Margin="-12,0,-12,0" Padding="6" CornerRadius="6,6,0,0">
        <TextBlock Text="Optionen" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Foreground="FloralWhite"/>
      </Border>

      <CheckBox x:Name="CheckBox_ZSK"  Grid.Row="1" Margin="0,0,12,0" Grid.RowSpan="1" VerticalAlignment="Bottom"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="Zusi-Streckenkarte anzeigen" Margin="0,12,0,0"/>
      <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="10">
            <Run>Die Zusi-Streckenkarte zeigt alle in Zusi vorhandenen Strecken an.</Run>
            <LineBreak/>
            <Run>Links in der Zusi Streckenkarte ermöglichen die direkte Auswahl von Fahrplänen und Zügen abhängig, von der ausgewählten Strecke oder Betriebsstelle. </Run>
      </TextBlock>
      <TextBox x:Name="TextBox_ZSK_URL" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="12" Background="White"/>

      <CheckBox x:Name="CheckBox_ZDB" Grid.Row="4" Margin="0,0,12,0" Grid.RowSpan="1" VerticalAlignment="Bottom" />
      <TextBlock Grid.Row="4" Grid.Column="1" Text="Zusi-Datenbank anzeigen" Margin="0,12,0,0"/>
      <TextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="10">
            <Run>Die Zusi-Datenbank ermöglicht die Auswahl von Zügen abhängig von vielfältigen Kriterien.</Run>
      </TextBlock>
      <TextBox x:Name="TextBox_ZDB_URL" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="12" Background="White"/>

      <CheckBox x:Name="CheckBox_Bfpl" Grid.Row="7" Margin="0,0,12,0" Grid.RowSpan="1" VerticalAlignment="Bottom" />
      <TextBlock Grid.Row="7" Grid.Column="1" Text="Bildfahrplan anzeigen" Margin="0,12,0,0"/>
      <TextBlock Grid.Row="8" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="10">
      <Run>Der Bildfahrplan zeigt Zugfahrpläne grafisch an und ermöglich ein Monitoring der Fahrt</Run>
      </TextBlock>
      <TextBox x:Name="TextBox_Bfpl_Exe" Grid.Row="9" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="12" Background="White"/>

      <!--<CheckBox x:Name="CheckBox_Zusi_Exe" Grid.Row="10" Margin="0,0,12,0" Grid.RowSpan="1" VerticalAlignment="Bottom" />
      <TextBlock Grid.Row="10" Grid.Column="1" Text="Zusi Exe individuell angeben" Margin="0,12,0,0"/>
      <TextBlock Grid.Row="11" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="10">
 <Run>Hier kann der Pfad und Dateiname der Zusi-Exe angegeben werden, wenn er nicht automatisch gefunden wurde</Run>
      </TextBlock>
      <TextBox x:Name="TextBox_Zusi_Exe" Grid.Row="14" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="12" Background="White"/>-->

      <CheckBox x:Name="CheckBox_Start_FIS" Grid.Row="10" Margin="0,0,12,0" Grid.RowSpan="1" VerticalAlignment="Bottom" />
      <TextBlock Grid.Row="10" Grid.Column="1" Text="FIS starten" Margin="0,12,0,0"/>
      <TextBlock Grid.Row="11" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="10">
        <Run>Für Züge, die ein FIS haben, FIS starten (nur in Verbindung mit Fahrplan Optimierung)</Run>
        <LineBreak/>
        <Run>Hier kann der Pfad zu ZusiDisplay eingegeben werden</Run>
      </TextBlock>
      <TextBox x:Name="TextBox_ZusiDisplay_Exe" Grid.Row="12" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="12" Background="White"/>
      
      <TextBlock Grid.Row="13" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="10">
  <Run>Zusi-Display Parameter</Run>
      </TextBlock>
      <TextBox x:Name="TextBox_ZusiDisplay_Param" Grid.Row="14" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="12" Background="White"/>

      <CheckBox x:Name="CheckBox_Start_ZusiMeter" Grid.Row="15" Margin="0,0,12,0" Grid.RowSpan="1" VerticalAlignment="Bottom" />
      <TextBlock Grid.Row="15" Grid.Column="1" Text="ZusiMeter starten" Margin="0,12,0,0"/>
      <TextBlock Grid.Row="16" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="10">
      <Run>Hier kann der Pfad zu ZusiMeter eingegeben werden</Run>
      </TextBlock>
      <TextBox x:Name="TextBox_ZusiMeter_Exe" Grid.Row="17" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="12" Background="White"/>

      <TextBlock Grid.Row="18" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="10">
<Run>Zusi-Meter Parameter</Run>
      </TextBlock>
      <TextBox x:Name="TextBox_ZusiMeter_Param" Grid.Row="19" Grid.Column="1" TextWrapping="Wrap" MaxWidth="450" Margin="12,0,0,0" FontSize="12" Background="White"/>

      <StackPanel Orientation="Horizontal" Grid.Row="20" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,12,0,0">
        <Button Click="SaveOptions_Click" Content="Ü_bernehmen" IsDefault="True" Style="{StaticResource ZusiStartGreenButtonStyle}" Margin="0,0,6,0"/>
        <Button Content="Abbrechen" IsCancel="True" Style="{StaticResource ZusiStartRedButtonStyle}"/>
      </StackPanel>
    </Grid>
  </Border>
 
</Window>
