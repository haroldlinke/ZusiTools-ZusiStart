<Window x:Class="ZusiStart.Dialogs.TrainReplacementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:ZusiStart.Dialogs"
        xmlns:b="clr-namespace:Sovoma.ControlsKit.Behaviors;assembly=Sovoma.ControlsKit"
        xmlns:ctrls="clr-namespace:ZusiStart.Controls" 
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:vm="clr-namespace:ZusiStart.Data"
        xmlns:z="clr-namespace:ZusiMeterGaugesLib.Gauges;assembly=ZusiMeterGaugesLib"
        mc:Ignorable="d"
        b:DialogBehavior.IsDialog="True"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="{Binding DialogTitle}" UseLayoutRounding="True" SnapsToDevicePixels="True" SizeToContent="WidthAndHeight" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <!--<local:ZugartConverter x:Key="ZugartConverter"/>
    <local:BremsstellungConverter x:Key="BremsstellungConverter"/>
    <local:DoubleHeadingBorderConverter x:Key="DoubleHeadingBorderConverter"/>
    <local:BrakeHundredthEnabledConverter x:Key="BrakeHundredthEnabledConverter"/>
    <local:OrientationConverter x:Key="OrientationConverter"/>-->

    <CollectionViewSource x:Key="cvsReplTrains" Source="{Binding ReplacementTrains, Source={x:Static vm:DataManager.Instance}}"/>
    <Style x:Key="MyStyle" TargetType="{x:Type Button}">

    </Style>
  </Window.Resources>

  <Grid Margin="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    

    <Border Grid.Row="1" Margin="0" Padding="6" BorderThickness="1" BorderBrush="Black" CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="1" Margin="3,0,0,0" MinWidth="800">
          <TextBlock DockPanel.Dock="Top" Text="Neuer Zug" FontWeight="Bold"/>
          <Grid Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
              <RowDefinition/>
              <RowDefinition/>
              <RowDefinition/>
              <RowDefinition/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition SharedSizeGroup="A" Width="0*"/>
              <ColumnDefinition Width="20*"/>
              <ColumnDefinition SharedSizeGroup="B" Width="111*"/>
              <ColumnDefinition SharedSizeGroup="C" Width="101*"/>
              <ColumnDefinition Width="127*"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.ColumnSpan="5" ItemsSource="{Binding Source={StaticResource cvsReplTrains}}" SelectedIndex="{Binding SelectedReplTrain1}" IsSynchronizedWithCurrentItem="True" IsReadOnly="True">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            
            
            <!--<CheckBox x:Name="Gedreht1" Content="Lok gedreht" Grid.Row="3" Grid.ColumnSpan="1" Margin="0,5,0,0" Grid.Column="2" Checked="CheckBox_Checked"/>
            <CheckBox x:Name="Lokrichtung" Content="Lok immer vorne" Grid.Row="3" Grid.ColumnSpan="1" Margin="0,5,0,0" Grid.Column="3" Checked="CheckBox_Checked"/>-->
            <CheckBox x:Name="Zuggedreht" Content="Beim Wenden kompletten Zug drehen" Grid.Row="3" Grid.ColumnSpan="1" Margin="0,5,0,0" Grid.Column="5" Checked="CheckBox_Checked"/>
            <!-- ==================================== Ausgewählter Zug Info ==================================== -->
            <ctrls:TimeTableInfoControl Grid.Row="4" Grid.Column="0" Source="{Binding TRSelectedZug, Mode=OneWay}" Margin="0,6,0,0" Visibility="Visible" Grid.ColumnSpan="6"/>

          </Grid>
        </DockPanel>
      </Grid>
    </Border>

    

    <!--<Border Grid.Row="3" Padding="6" BorderThickness="1" BorderBrush="Black" Margin="0,6,0,0" CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Zugdatenvorgabe für neuen Zug" FontWeight="Bold"/>
        <Border Grid.Row="1" Margin="0,6,0,0">
          <Grid Height="120">
            <TextBlock Text="Zugart/BRA"/>
            --><!--<z:Knob SelectedNotch="{Binding Zugart, Mode=TwoWay, Converter={StaticResource ZugartConverter}}" LabelBrush="Black" SelectedLabelBrush="OrangeRed" VerticalAlignment="Center" Margin="0,15,0,0" 
                                Notches="{Binding Zugarten}" IsInteractive="{Binding Zugarten.Count, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;3}" FirstNotch="-45" Foreground="Black" HorizontalAlignment="Center"/>--><!--
          </Grid>
        </Border>
        <Border Grid.Column="1" Grid.Row="1" Margin="0,6,0,0">
          <Grid Height="120">
            <TextBlock Text="Bremsstellung"/>
            <z:Knob SelectedNotch="{Binding Bremsstellung, Converter={StaticResource BremsstellungConverter}, Mode=TwoWay}" LabelBrush="Black" SelectedLabelBrush="OrangeRed" VerticalAlignment="Center" Margin="0,15,0,0" 
                                IsInteractive="{Binding Zugarten.Count, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;1}" FirstNotch="-45" HorizontalAlignment="Center" Foreground="Black">
              <z:Knob.Notches>
                <z:Notch Label="automatisch"/>
                <z:Notch Label="G"/>
                <z:Notch Label="P"/>
                <z:Notch Label="R"/>
              </z:Knob.Notches>
            </z:Knob>
          </Grid>
        </Border>
        <Border Grid.Column="2" Grid.Row="1" Margin="0,6,0,0">
          <Grid Height="120">
            <TextBlock Text="Bremshundertstel"/>
            <DockPanel HorizontalAlignment="Center">
              <z:Knob x:Name="kbBrh" LabelBrush="Black" SelectedLabelBrush="OrangeRed" VerticalAlignment="Center" Margin="0,15,0,0" CanRoundAbout="False"
                                    SelectedNotch="{Binding BrHSelector, Mode=TwoWay}" AutoGenerateNotches="False" Foreground="Black" HorizontalAlignment="Center">
                <z:Knob.IsInteractive>
                  <MultiBinding Converter="{StaticResource BrakeHundredthEnabledConverter}">
                    <Binding Path="Zugarten.Count"/>
                    <Binding Path="Zugart"/>
                  </MultiBinding>
                </z:Knob.IsInteractive>
                <z:Knob.Notches>
                  <z:Notch Position="45"/>
                  <z:Notch Position="135"/>
                </z:Knob.Notches>
              </z:Knob>
              <Grid VerticalAlignment="Center" Margin="8,15,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="automatisch" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,2,0,0"
                                            IsEnabled="{Binding SelectedNotch, ElementName=kbBrh, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;0}">
                  <TextBox Width="60" Text="{Binding BrH, Mode=TwoWay}">
                    --><!--<i:Interaction.Behaviors>
                      <bb:TextBoxInputRegExBehavior EmptyValue="0" MaxLength="3" RegularExpression="^[0-9]+$"/>
                    </i:Interaction.Behaviors>--><!--
                  </TextBox>
                </StackPanel>
              </Grid>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>-->

    <Grid Grid.Row="4" Margin="0,6,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
        <Button Content="Abbrechen" IsCancel="True" Style="{StaticResource CommandButtonStyle}" Margin="6,3,0,3"/>
        <Button Command="{x:Static local:TrainReplacementDialog.ReplTrainCommand}" Content="{Binding ButtonText}" Style="{StaticResource CommandButtonStyle}" Margin="6,3,0,3"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
