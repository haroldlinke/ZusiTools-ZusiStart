<Window x:Class="ZusiStart.Dialogs.LocoReplacementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:ZusiStart.Dialogs"
        xmlns:b="clr-namespace:Sovoma.ControlsKit.Behaviors;assembly=Sovoma.ControlsKit"
        xmlns:bb="clr-namespace:ZusiStart.Data"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:vm="clr-namespace:ZusiStart.Data"
        xmlns:z="clr-namespace:ZusiMeterGaugesLib.Gauges;assembly=ZusiMeterGaugesLib"
        mc:Ignorable="d"
        b:DialogBehavior.IsDialog="True"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="{Binding DialogTitle}" UseLayoutRounding="True" SnapsToDevicePixels="True" SizeToContent="WidthAndHeight" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <local:ZugartConverter x:Key="ZugartConverter"/>
    <local:BremsstellungConverter x:Key="BremsstellungConverter"/>
    <local:DoubleHeadingBorderConverter x:Key="DoubleHeadingBorderConverter"/>
    <local:BrakeHundredthEnabledConverter x:Key="BrakeHundredthEnabledConverter"/>
    <local:OrientationConverter x:Key="OrientationConverter"/>

    <CollectionViewSource x:Key="cvsReplLocos1" Source="{Binding ReplacementLocos, Source={x:Static vm:DataManager.Instance}}"/>
    <CollectionViewSource x:Key="cvsReplLocos2" Source="{Binding ReplacementLocos, Source={x:Static vm:DataManager.Instance}}"/>

    <Style x:Key="MyStyle" TargetType="{x:Type Button}">

    </Style>
  </Window.Resources>

  <Grid Margin="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Padding="6" BorderThickness="1" CornerRadius="6" BorderBrush="Black" Margin="0,0,0,6"
                Visibility="{Binding HasDoubleHeading, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid>
        <CheckBox Content="Mehrfachtraktion auflösen" IsChecked="{Binding ReleaseDoubleHeading}"/>
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="0" Padding="6" BorderThickness="1" BorderBrush="Black" CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,3,0" MinWidth="300">
          <TextBlock DockPanel.Dock="Top" FontWeight="Bold">
                    <Run>Die</Run> <Run Text="{Binding TextFirstLoco, Mode=OneWay}"/>
          </TextBlock>
          <StackPanel Margin="0,6,0,0">
            <TextBlock Text="{Binding BRFirstLoco}"/>
            <TextBlock Text="{Binding DescrFirstLoco}" TextTrimming="WordEllipsis" FontStyle="Italic" FontSize="11"/>
            <TextBlock Text="{Binding BRSecondLoco}" Margin="0,3,0,0"
                                   Visibility="{Binding ReleaseDoubleHeading, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="{Binding DescrSecondLoco}" TextTrimming="WordEllipsis" FontStyle="Italic" FontSize="11"
                                   Visibility="{Binding ReleaseDoubleHeading, Converter={StaticResource BoolToVisibilityConverter}}"/>
          </StackPanel>
        </DockPanel>
        <DockPanel Grid.Column="1" Margin="3,0,0,0" MinWidth="300">
          <TextBlock DockPanel.Dock="Top" Text="ersetzen durch" FontWeight="Bold"/>
          <Grid Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
              <RowDefinition/>
              <RowDefinition/>
              <RowDefinition/>
              <RowDefinition/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition SharedSizeGroup="A" Width="0*"/>
              <ColumnDefinition Width="20*"/>
              <ColumnDefinition SharedSizeGroup="B" Width="111*"/>
              <ColumnDefinition SharedSizeGroup="C" Width="101*"/>
              <ColumnDefinition Width="127*"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.ColumnSpan="5" ItemsSource="{Binding Source={StaticResource cvsReplLocos1}}" SelectedIndex="{Binding SelectedReplLoco1}" IsSynchronizedWithCurrentItem="True" IsReadOnly="True">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="als" VerticalAlignment="Top" Grid.Row="1" Margin="0,5,6,0" Grid.ColumnSpan="2"/>
            <RadioButton Content="führende Lok" GroupName="LocoPosition1"
                                     IsEnabled="{Binding SelectedReplLoco1, Mode=OneWay, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;\=0}"
                                     IsChecked="{Binding LocoPosition1, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Leading}" VerticalAlignment="Top" Grid.Row="1" Grid.Column="2" Margin="0,6,12,0"/>
            <RadioButton Content="schiebende Lok" GroupName="LocoPosition1"
                                     IsEnabled="{Binding SelectedReplLoco1, Mode=OneWay, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;\=0}"
                                     IsChecked="{Binding LocoPosition1, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Pushing}" VerticalAlignment="Top" Grid.Row="1" Grid.Column="3" Margin="0,6,0,0"/>
            <TextBlock Text="in" VerticalAlignment="Top" Grid.Row="2" Margin="0,5,6,0" Grid.ColumnSpan="2"/>
            <RadioButton Content="Einfachtraktion" Grid.Row="2" GroupName="Traction1"
                                     IsEnabled="{Binding SelectedReplLoco1, Mode=OneWay, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;\=0}"
                                     IsChecked="{Binding Traction1, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SingleHeading}" VerticalAlignment="Top" Grid.Column="2" Margin="0,7,12,0"/>
            <RadioButton Content="Doppeltraktion" Grid.Row="2" Grid.Column="3" GroupName="Traction1" VerticalAlignment="Top" Margin="0,7,0,0"
                                     IsChecked="{Binding Traction1, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DoubleHeading}"
                                     IsEnabled="{Binding SelectedReplLoco1, Mode=OneWay, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;\=0}"
                                     Visibility="{Binding ReleaseDoubleHeading, Converter={StaticResource ReverseBoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"/>
            <CheckBox x:Name="IgnoreDoors" Content="Türsystem ignorieren" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,5,0,0" Grid.Column="2" Checked="CheckBox_Checked"/>
            <CheckBox x:Name="Gedreht1" Content="Lok gedreht" Grid.Row="3" Grid.ColumnSpan="1" Margin="0,5,0,0" Grid.Column="2" Checked="CheckBox_Checked"/>
            <CheckBox x:Name="Lokrichtung" Content="Lok immer vorne" Grid.Row="3" Grid.ColumnSpan="1" Margin="0,5,0,0" Grid.Column="3" Checked="CheckBox_Checked"/>
            <CheckBox x:Name="Zuggedreht" Content="Zug drehen" Grid.Row="3" Grid.ColumnSpan="1" Margin="10,5,0,0" Grid.Column="4" Checked="CheckBox_Checked"/>
          </Grid>
        </DockPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="0,6,0,0" Padding="6" BorderThickness="1" BorderBrush="Black" CornerRadius="6">
      <Border.Visibility>
        <MultiBinding Converter="{StaticResource DoubleHeadingBorderConverter}">
          <Binding Path="HasDoubleHeading"/>
          <Binding Path="ReleaseDoubleHeading"/>
        </MultiBinding>
      </Border.Visibility>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,3,0" MinWidth="300">
          <TextBlock DockPanel.Dock="Top" FontWeight="Bold">
                    <Run>Die</Run> <Run Text="{Binding TextSecondLoco, Mode=OneWay}"/>
          </TextBlock>
          <StackPanel Margin="0,6,0,0">
            <TextBlock Text="{Binding BRSecondLoco}"/>
            <TextBlock Text="{Binding DescrSecondLoco}" TextTrimming="WordEllipsis" FontStyle="Italic" FontSize="11"/>
          </StackPanel>
        </DockPanel>
        <DockPanel Grid.Column="1" Margin="3,0,0,0" MinWidth="300">
          <TextBlock DockPanel.Dock="Top" Text="ersetzen durch" FontWeight="Bold"/>
          <Grid Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
              <RowDefinition/>
              <RowDefinition/>
              <RowDefinition/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition SharedSizeGroup="A"/>
              <ColumnDefinition SharedSizeGroup="B"/>
              <ColumnDefinition SharedSizeGroup="C"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.ColumnSpan="4" ItemsSource="{Binding Source={StaticResource cvsReplLocos2}}" SelectedIndex="{Binding SelectedReplLoco2}" IsSynchronizedWithCurrentItem="True" IsReadOnly="True">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="als" VerticalAlignment="Center" Grid.Row="1" Margin="0,5,6,0"/>
            <RadioButton Content="{Binding LocoPosition2aText}" GroupName="LocoPosition2" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" Margin="0,6,12,0"
                                     IsChecked="{Binding LocoPosition2, Mode=TwoWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Leading}"
                                     IsEnabled="{Binding LocoPosition2aEnabled}"/>
            <RadioButton Content="{Binding LocoPosition2bText}" GroupName="LocoPosition2" VerticalAlignment="Center" Grid.Row="1" Grid.Column="2" Margin="0,6,0,0"
                                     IsEnabled="{Binding SelectedReplLoco2, Mode=OneWay, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;\=0}"
                                     IsChecked="{Binding LocoPosition2, Mode=TwoWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Pushing}"/>
            <TextBlock Text="in" VerticalAlignment="Center" Grid.Row="2" Margin="0,5,6,0"/>
            <RadioButton Content="Einfachtraktion" Grid.Row="2" GroupName="Traction2"
                                     IsEnabled="{Binding SelectedReplLoco2, Mode=OneWay, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;\=0}"
                                     IsChecked="{Binding Traction2, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SingleHeading}" VerticalAlignment="Center" Grid.Column="1" Margin="0,6,12,0"/>
            <RadioButton Content="Doppeltraktion" Grid.Row="2" Grid.Column="2" GroupName="Traction2" VerticalAlignment="Center" Margin="0,6,0,0"
                                     IsEnabled="{Binding SelectedReplLoco2, Mode=OneWay, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;\=0}"
                                     IsChecked="{Binding Traction2, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DoubleHeading}"
                                     Visibility="{Binding ReleaseDoubleHeading, Converter={StaticResource ReverseBoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"/>
            <CheckBox x:Name="Gedreht2" Content="Lok gedreht" Grid.Row="3" Grid.ColumnSpan="1" Margin="0,5,0,0" Grid.Column="1" Checked="CheckBox_Checked"/>
          </Grid>
        </DockPanel>
      </Grid>
    </Border>

    <Border Grid.Row="3" Padding="6" BorderThickness="1" BorderBrush="Black" Margin="0,6,0,0" CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Zugdatenvorgabe für neue Lok" FontWeight="Bold"/>
        <Border Grid.Row="1" Margin="0,6,0,0">
          <Grid Height="120">
            <TextBlock Text="Zugart/BRA"/>
            <z:Knob SelectedNotch="{Binding Zugart, Mode=TwoWay, Converter={StaticResource ZugartConverter}}" LabelBrush="Black" SelectedLabelBrush="OrangeRed" VerticalAlignment="Center" Margin="0,15,0,0" 
                                Notches="{Binding Zugarten}" IsInteractive="{Binding Zugarten.Count, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;3}" FirstNotch="-45" Foreground="Black" HorizontalAlignment="Center"/>
          </Grid>
        </Border>
        <Border Grid.Column="1" Grid.Row="1" Margin="0,6,0,0">
          <Grid Height="120">
            <TextBlock Text="Bremsstellung"/>
            <z:Knob SelectedNotch="{Binding Bremsstellung, Converter={StaticResource BremsstellungConverter}, Mode=TwoWay}" LabelBrush="Black" SelectedLabelBrush="OrangeRed" VerticalAlignment="Center" Margin="0,15,0,0" 
                                IsInteractive="{Binding Zugarten.Count, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;1}" FirstNotch="-45" HorizontalAlignment="Center" Foreground="Black">
              <z:Knob.Notches>
                <z:Notch Label="automatisch"/>
                <z:Notch Label="G"/>
                <z:Notch Label="P"/>
                <z:Notch Label="R"/>
              </z:Knob.Notches>
            </z:Knob>
          </Grid>
        </Border>
        <Border Grid.Column="2" Grid.Row="1" Margin="0,6,0,0">
          <Grid Height="120">
            <TextBlock Text="Bremshundertstel"/>
            <DockPanel HorizontalAlignment="Center">
              <z:Knob x:Name="kbBrh" LabelBrush="Black" SelectedLabelBrush="OrangeRed" VerticalAlignment="Center" Margin="0,15,0,0" CanRoundAbout="False"
                                    SelectedNotch="{Binding BrHSelector, Mode=TwoWay}" AutoGenerateNotches="False" Foreground="Black" HorizontalAlignment="Center">
                <z:Knob.IsInteractive>
                  <MultiBinding Converter="{StaticResource BrakeHundredthEnabledConverter}">
                    <Binding Path="Zugarten.Count"/>
                    <Binding Path="Zugart"/>
                  </MultiBinding>
                </z:Knob.IsInteractive>
                <z:Knob.Notches>
                  <z:Notch Position="45"/>
                  <z:Notch Position="135"/>
                </z:Knob.Notches>
              </z:Knob>
              <Grid VerticalAlignment="Center" Margin="8,15,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="automatisch" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,2,0,0"
                                            IsEnabled="{Binding SelectedNotch, ElementName=kbBrh, Converter={StaticResource LogicOperatorConverter}, ConverterParameter=&gt;0}">
                  <TextBox Width="60" Text="{Binding BrH, Mode=TwoWay}">
                    <!--<i:Interaction.Behaviors>
                      <bb:TextBoxInputRegExBehavior EmptyValue="0" MaxLength="3" RegularExpression="^[0-9]+$"/>
                    </i:Interaction.Behaviors>-->
                  </TextBox>
                </StackPanel>
              </Grid>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="0,6,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border BorderThickness="1" CornerRadius="6" BorderBrush="Black" Margin="0" Padding="6"
                    Visibility="{Binding ShowPantographOptions, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}">
        <Grid IsEnabled="{Binding IsFirstLocoElectrical}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Stromabnehmer der neuen Lok(s)" FontWeight="Bold"/>
          <Border Grid.Row="1" Margin="0,0,6,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="1. Lok" Margin="0,0,0,3" FontWeight="Bold" FontStyle="Italic" Visibility="{Binding IsSecondLocoElectrical, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}"/>
              <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                <StackPanel>
                  <z:Knob SelectedNotch="{Binding Pantograph1_0, Mode=TwoWay}" LabelBrush="Black" SelectedLabelBrush="OrangeRed" AutoGenerateNotches="False" KnobSize="32" FontSize="10" Margin="0,6,0,0" Foreground="Black" MinWidth="153">
                    <z:Knob.Notches>
                      <z:Notch Label="gesenkt" Position="-45"/>
                      <z:Notch Label="gehoben" Position="45" IsLit="True"/>
                    </z:Knob.Notches>
                  </z:Knob>
                  <TextBlock Text="vorn" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel>
                  <z:Knob SelectedNotch="{Binding Pantograph1_1, Mode=TwoWay}" LabelBrush="Black" SelectedLabelBrush="OrangeRed" AutoGenerateNotches="False" KnobSize="32" FontSize="10" Margin="0,6,0,0" Foreground="Black" HorizontalAlignment="Center" MinWidth="153">
                    <z:Knob.Notches>
                      <z:Notch Label="gesenkt" Position="-45"/>
                      <z:Notch Label="gehoben" Position="45" IsLit="True"/>
                    </z:Knob.Notches>
                  </z:Knob>
                  <TextBlock Text="hinten" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="0,6,0,0">
                  <z:Knob SelectedNotch="{Binding Pantograph1_2, Mode=TwoWay}" LabelBrush="Black" SelectedLabelBrush="OrangeRed" AutoGenerateNotches="False" KnobSize="32" FontSize="10" Margin="0,3,0,0" Foreground="Black" HorizontalAlignment="Center" MinWidth="153">
                    <z:Knob.Notches>
                      <z:Notch Label="gesenkt" Position="-45"/>
                      <z:Notch Label="gehoben" Position="45" IsLit="True"/>
                    </z:Knob.Notches>
                  </z:Knob>
                  <TextBlock Text="zweiter vorn" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="0,6,0,0">
                  <z:Knob SelectedNotch="{Binding Pantograph1_3, Mode=TwoWay}" LabelBrush="Black" SelectedLabelBrush="OrangeRed" AutoGenerateNotches="False" KnobSize="32" FontSize="10" Margin="0,3,0,0" Foreground="Black" HorizontalAlignment="Center" MinWidth="153">
                    <z:Knob.Notches>
                      <z:Notch Label="gesenkt" Position="-45"/>
                      <z:Notch Label="gehoben" Position="45" IsLit="True"/>
                    </z:Knob.Notches>
                  </z:Knob>
                  <TextBlock Text="zweiter hinten" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
              </UniformGrid>
            </Grid>
          </Border>
          <Border Grid.Row="1" Margin="6,0,0,0" Grid.Column="1">
            <Grid Visibility="{Binding IsSecondLocoElectrical, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Hidden}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="2. Lok" Margin="0,0,0,3" FontWeight="Bold" FontStyle="Italic"/>
              <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                <StackPanel>
                  <z:Knob SelectedNotch="{Binding Pantograph2_0, Mode=TwoWay}" LabelBrush="Black" SelectedLabelBrush="OrangeRed" AutoGenerateNotches="False" KnobSize="32" FontSize="10" Margin="0,6,0,0" Foreground="Black" HorizontalAlignment="Center" MinWidth="153">
                    <z:Knob.Notches>
                      <z:Notch Label="gesenkt" Position="-45"/>
                      <z:Notch Label="gehoben" Position="45" IsLit="True"/>
                    </z:Knob.Notches>
                  </z:Knob>
                  <TextBlock Text="vorn" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel>
                  <z:Knob SelectedNotch="{Binding Pantograph2_1, Mode=TwoWay}" LabelBrush="Black" SelectedLabelBrush="OrangeRed" AutoGenerateNotches="False" KnobSize="32" FontSize="10" Margin="0,6,0,0" Foreground="Black" HorizontalAlignment="Center" MinWidth="153">
                    <z:Knob.Notches>
                      <z:Notch Label="gesenkt" Position="-45"/>
                      <z:Notch Label="gehoben" Position="45" IsLit="True"/>
                    </z:Knob.Notches>
                  </z:Knob>
                  <TextBlock Text="hinten" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="0,6,0,0">
                  <z:Knob SelectedNotch="{Binding Pantograph2_2, Mode=TwoWay}" LabelBrush="Black" SelectedLabelBrush="OrangeRed" AutoGenerateNotches="False" KnobSize="32" FontSize="10" Margin="0,3,0,0" Foreground="Black" HorizontalAlignment="Center" MinWidth="153">
                    <z:Knob.Notches>
                      <z:Notch Label="gesenkt" Position="-45"/>
                      <z:Notch Label="gehoben" Position="45" IsLit="True"/>
                    </z:Knob.Notches>
                  </z:Knob>
                  <TextBlock Text="zweiter vorn" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="0,6,0,0">
                  <z:Knob SelectedNotch="{Binding Pantograph2_3, Mode=TwoWay}" LabelBrush="Black" SelectedLabelBrush="OrangeRed" AutoGenerateNotches="False" KnobSize="32" FontSize="10" Margin="0,3,0,0" Foreground="Black" HorizontalAlignment="Center" MinWidth="153">
                    <z:Knob.Notches>
                      <z:Notch Label="gesenkt" Position="-45"/>
                      <z:Notch Label="gehoben" Position="45" IsLit="True"/>
                    </z:Knob.Notches>
                  </z:Knob>
                  <TextBlock Text="zweiter hinten" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
              </UniformGrid>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="{Binding ShowPantographOptions, Converter={StaticResource OrientationConverter}}">
        <Button Content="Abbrechen" IsCancel="True" Style="{StaticResource CommandButtonStyle}" Margin="6,3,0,3"/>
        <Button Command="{x:Static local:LocoReplacementDialog.ReplLocoCommand}" Content="{Binding ButtonText}" Style="{StaticResource CommandButtonStyle}" Margin="6,3,0,3"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
