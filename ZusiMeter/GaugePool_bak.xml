			   SmallTickFrequency="0.05" Unit="Percent" Maximum="1" TickFrequency="0.2" DialScale="0.01" Theme="Flowmeter"/>
		<Gauge displayGroup="Normierte" displayName="Motorlast (+)" FtdID="MotorlastNormiert" Name="Motorlast"
			   Maximum="1" Minimum="-1" TickFrequency="0.5" DialScale="0.01" SmallTickFrequency="0.1" Unit="Percent" Theme="Flowmeter">
			<AltID>MotorlastNormiert</AltID>
			<AltID>SteuerwagenMotorlastNormiert</AltID>
		</Gauge>
		<Gauge displayGroup="Normierte" displayName="Zug-/Bremskraftsoll (+)" FtdID="ZugBremskraftSollNormiert" Name="Zug-/Bremskraftsoll"
			   Maximum="1" Minimum="-1" TickFrequency="0.5" DialScale="0.01" SmallTickFrequency="0.1" Unit="Percent" Theme="Flowmeter">
			<AltID>ZugBremskraftSollNormiert</AltID>
			<AltID>SteuerwagenZugBremskraftSollNormiert</AltID>
		</Gauge>
		<Gauge displayGroup="Normierte" displayName="Zug-/Bremskraftsoll absolut (+)" FtdID="ZugBremskraftSollAbsolutNormiert" Name="Zug-/Bremskraftsoll Absolut"
			   Maximum="1" Minimum="-1" TickFrequency="0.5" DialScale="0.01" SmallTickFrequency="0.1" Unit="Percent" Theme="Flowmeter">
			<AltID>ZugBremskraftSollAbsolutNormiert</AltID>
			<AltID>SteuerwagenZugBremskraftSollAbsolutNormiert</AltID>
		</Gauge>

		<!-- **** Sonstige **** -->
		<!--
    <Gauge displayGroup="Sonstige" displayName="Fahrstufe" FtdID="Fahrstufe" Name="Fahrstufe"/>
    -->
	</HorizontalGauges>

	<VerticalGauges>
		<!-- **** Tachometer **** -->
		<Gauge displayGroup="Tachometer" displayName="Geschwindigkeit" type="VerticalTachometerGauge" FtdID="Geschwindigkeit" Name="Geschwindigkeit"/>

