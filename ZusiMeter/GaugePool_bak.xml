			<AltID>ZugkraftGesamt</AltID>
			<AltID>SteuerwagenZugkraftGesamt</AltID>
		</Gauge>
		<Gauge displayGroup="Dynamometer" displayName="E-Bremskraft (+)" FtdID="ZugkraftGesamt" Name="E-Bremskraft"
			   DialScale="-10000" TickFrequency="-10000" Maximum="-100000" LabelingFrequency="2" SmallTickFrequency="-5000" Unit="Kraftx10000" Theme="Dynamometer">
			<AltID>ZugkraftGesamt</AltID>
			<AltID>SteuerwagenZugkraftGesamt</AltID>
		</Gauge>
		<Gauge displayGroup="Dynamometer" displayName="Zugkraft pro Achse (+)" FtdID="ZugkraftProAchse" Name="Zugkraft pro Achse"
			   DialScale="1000" TickFrequency="10000" Maximum="70000" SmallTickFrequency="2000" Unit="Kraftx1000" Theme="Dynamometer">
			<AltID>ZugkraftProAchse</AltID>
			<AltID>SteuerwagenZugkraftProAchse</AltID>
		</Gauge>
		<Gauge displayGroup="Dynamometer" displayName="Zugkraftsoll Gesamt (+)" FtdID="ZugkraftSollGesamt" Name="Zugkraft Soll Gesamt"
			   DialScale="1000" TickFrequency="20000" Maximum="200000" LabelingFrequency="2" SmallTickFrequency="10000" Unit="Kraftx1000" Theme="Dynamometer">
			<AltID>ZugkraftSollGesamt</AltID>
			<AltID>SteuerwagenZugkraftSollGesamt</AltID>
		</Gauge>
		<Gauge displayGroup="Dynamometer" displayName="Zugkraftsoll proAchse (+)" FtdID="ZugkraftSollProAchse" Name="Zugkraft Soll proAchse"
			   DialScale="100" Maximum="10000" TickFrequency="1000" SmallTickFrequency="500" Unit="Kraftx100" Theme="Dynamometer">
			<AltID>ZugkraftSollProAchse</AltID>
			<AltID>SteuerwagenZugkraftSollProAchse</AltID>
		</Gauge>
		<Gauge displayGroup="Dynamometer" displayName="Zugkraftvorschlag Autopilot" FtdID="ZugkraftGesamt" Name="Zugkraftvorschlag Autopilot"
			   TickFrequency="20000" DialScale="1000" Maximum="200000" LabelingFrequency="2" SmallTickFrequency="10000" Unit="Kraftx1000" Theme="Dynamometer"/>

		<!-- **** Amperemeter **** -->
		<Gauge displayGroup="Amperemeter" displayName="Oberstrom (+)" FtdID="Oberstrom" Name="Oberstrom"
			   Maximum="600" TickFrequency="100" SmallTickFrequency="20" Unit="Current" Theme="Amperemeter">
			<AltID>Oberstrom</AltID>
			<AltID>SteuerwagenOberstrom</AltID>
		</Gauge>
		<Gauge displayGroup="Amperemeter" displayName="Motorstrom (+)" FtdID="Motorstrom" Name="Motorstrom"
			   DialScale="1750" Maximum="14000" LabelingFrequency="2" TickFrequency="1750" SmallTickFrequency="875" Unit="Currentx1000" Theme="Amperemeter">
			<AltID>Motorstrom</AltID>
			<AltID>SteuerwagenMotorstrom</AltID>
		</Gauge>

		<!-- **** Voltmeter **** -->
		<Gauge displayGroup="Voltmeter" displayName="Fahrleitungsspannung (+)" FtdID="Fahrleitungsspannung" Name="Fahrleitungsspannung"
			   TickFrequency="1000" Maximum="18000" LabelingFrequency="2" DialScale="1000" SmallTickFrequency="500" Unit="Voltagex1000" Theme="Voltmeter">
			<AltID>Fahrleitungsspannung</AltID>
			<AltID>SteuerwagenFahrleitungsspannung</AltID>
		</Gauge>
		<Gauge displayGroup="Voltmeter" displayName="Motorspannung" FtdID="Motorspannung" Name="Motorspannung"
			   Maximum="600" TickFrequency="100" SmallTickFrequency="20" Unit="Voltage" Theme="Voltmeter">
			<AltID>Motorspannung</AltID>
			<AltID>SteuerwagenMotorspannung</AltID>
		</Gauge>

		<!-- **** Gyrometer **** -->
		<Gauge displayGroup="Gyrometer" displayName="Motordrehzahl Dieselmotor (+)" FtdID="Motordrehzahl" Name="Motordrehzahl"
			   TickFrequency="200" DialScale="100" Maximum="2000" SmallTickFrequency="100" Unit="Drehzahlx100" Theme="Gyrometer">
			<AltID>Motordrehzahl</AltID>
			<AltID>SteuerwagenMotordrehzahl</AltID>
		</Gauge>
		<Gauge displayGroup="Gyrometer" displayName="Motordrehzahl E-Motor (+)" FtdID="Motordrehzahl" Name="Motordrehzahl"
