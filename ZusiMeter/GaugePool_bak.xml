	<HorizontalGauges>
		<!-- **** Tachometer **** -->
		<Gauge displayGroup="Tachometer" displayName="Geschwindigkeit" type="HorizontalTachometerGauge" FtdID="Geschwindigkeit" Name="Geschwindigkeit"/>

		<!-- **** Manometer **** -->
		<Gauge displayGroup="Manometer" FtdID="DruckHauptluftleitung" Name="HLL"
			   Maximum="10" TickFrequency="1" SmallTickFrequency="0.5" Unit="Pressure" Theme="Manometer"/>
		<Gauge displayGroup="Manometer" FtdID="DruckHauptLuftBehaelter" Name="HBL"
			   Maximum="10" TickFrequency="1" SmallTickFrequency="0.5" Unit="Pressure" Theme="Manometer"/>
		<Gauge displayGroup="Manometer" FtdID="DruckBremszylinder" Name="Bremszylinder"
			   Maximum="10" TickFrequency="1" SmallTickFrequency="0.5" Unit="Pressure" Theme="Manometer"/>
		<Gauge displayGroup="Manometer" FtdID="DruckHilfsluftbehaelter" Name="Hilfsluftbehaelter"
			   Maximum="5" TickFrequency="1" SmallTickFrequency="0.2" Unit="Pressure" Theme="Manometer"/>
		<Gauge displayGroup="Manometer" FtdID="DruckZeitbehaelter" Name="Zeitbehaelter"
			   Maximum="2" TickFrequency="0.5" SmallTickFrequency="0.1" Unit="Pressure" Theme="Manometer"/>
