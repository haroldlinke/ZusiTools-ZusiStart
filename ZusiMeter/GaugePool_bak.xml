			   Maximum="10" TickFrequency="1" SmallTickFrequency="0.5" Unit="Pressure" Theme="Manometer"/>

		<!-- **** Dynamometer **** -->
		<Gauge displayGroup="Dynamometer" displayName="Zugkraft Gesamt (+)" FtdID="ZugkraftGesamt" Name="Zugkraft Gesamt"
