			<AltID>Motordrehzahl</AltID>
			<AltID>SteuerwagenMotordrehzahl</AltID>
		</Gauge>

		<!-- **** Torquemeter **** -->
		<Gauge displayGroup="Drehmoment" displayName="Motordrehmoment (+)" FtdID="Motordrehmoment" Name="Motordrehmoment"
			   Maximum="250" TickFrequency="50" SmallTickFrequency="10" Unit="Drehmoment" Theme="Torquemeter">
			<AltID>Motordrehmoment</AltID>
			<AltID>SteuerwagenMotordrehmoment</AltID>
		</Gauge>

		<!-- **** Accelerometer **** -->
		<Gauge displayGroup="Accelerometer" displayName="Fahren/Bremsen" FtdID="BeschleunigungX" Name="Fahren/Bremsen"
			   Minimum="-2" Maximum="1.5" TickFrequency="0.5" SmallTickFrequency="0.1" Unit="Beschleunigung" Theme="Accelerometer"/>
		<Gauge displayGroup="Accelerometer" displayName="Seitenbeschleunigung" FtdID="BeschleunigungY" Name="Seitenbeschleunigung"
			   Maximum="2" Minimum="-2" TickFrequency="0.5" SmallTickFrequency="0.1" Unit="Beschleunigung" Theme="Accelerometer"/>
		<Gauge displayGroup="Accelerometer" displayName="Vertikalbeschleunigung" FtdID="BeschleunigungZ" Name="Vertikalbeschleunigung"
			   Maximum="2" Minimum="-2" TickFrequency="0.5" SmallTickFrequency="0.1" Unit="Beschleunigung" Theme="Accelerometer"/>
		<Gauge displayGroup="Accelerometer" displayName="Drehbeschleunigung X-Achse" FtdID="DrehBeschleunigungX" Name="Drehbeschleunigung X-Achse"
			   Maximum="1" Minimum="-2" TickFrequency="0.5" SmallTickFrequency="0.1" Unit="Drehbeschleunigung" Theme="Accelerometer"/>
		<Gauge displayGroup="Accelerometer" displayName="Drehbeschleunigung Y-Achse" FtdID="DrehBeschleunigungY" Name="Drehbeschleunigung Y-Achse"
			   Maximum="1" Minimum="-2" TickFrequency="0.5" SmallTickFrequency="0.1" Unit="Drehbeschleunigung" Theme="Accelerometer"/>
