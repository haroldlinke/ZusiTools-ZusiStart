<ZusiMeter xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="zusimeter.xsd" version="1.9">
	<AnalogGauges>
		<!-- **** Tachometer **** -->
		<Gauge type="Tachometer" displayGroup="Tachometer" displayName="Tachometer (+)"/>
		<!-- **** Manometer **** -->
		<Gauge type="Manometer" displayGroup="Manometer" displayName="Bremse (+)"/>
		<Gauge type="BrakeManometer" displayGroup="Manometer" displayName="Druck HBL/HLL"/>
		<!-- **** Dynamometer **** -->
		<Gauge type="Dynamometer" displayGroup="Dynamometer" displayName="Zugkraft (+)"/>
		<!-- **** Amperemeter **** -->
		<Gauge type="Amperemeter" displayGroup="Amperemeter" displayName="Oberstrom / Motorstrom (+)"/>
		<!-- **** Voltmeter **** -->
		<Gauge type="Voltmeter" displayGroup="Voltmeter" displayName="Spannung (Fahrleitung, Motor) (+)"/>
		<!-- **** Gyrometer **** -->
		<Gauge type="Gyrometer" displayGroup="Gyrometer" displayName="Motordrehzahl (+)"/>
		<!-- **** Torquemeter **** -->
		<Gauge type="Torquemeter" displayGroup="Drehmoment" displayName="Motordrehmoment (+)"/>
		<!-- **** Accelerometer **** -->
		<Gauge type="Accelerometer" displayGroup="Accelerometer" displayName="Beschleunigung (+)"/>
		<!-- **** Uhr **** -->
		<Gauge type="Uhr" displayGroup="Uhr" displayName="Uhr"/>
		<!-- **** Normierte **** -->
		<Gauge type="FlowmeterA" displayGroup="Normierte" displayName="Motorlast, Zug-/Bremskraftsoll (+)"/>
		<Gauge type="FlowmeterB" displayGroup="Normierte" displayName="Luftstrom (Fbv, Zbv) (+)"/>
		<!-- **** Sonstige **** -->
		<Gauge type="Fahrstufe" displayGroup="Sonstige" displayName="Fahrstufe"/>
