			   Maximum="1" Minimum="-2" TickFrequency="0.5" SmallTickFrequency="0.1" Unit="Drehbeschleunigung" Theme="Accelerometer"/>

		<!-- **** Normierte **** -->
		<Gauge displayGroup="Normierte" displayName="Luftstrom Fbv" FtdID="LuftstromFbv" Name="Luftstrom Fbv"
