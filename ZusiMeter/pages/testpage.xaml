<Window x:Class="ZusiMeter.Pages.TestPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZusiMeter.Pages"
        xmlns:zmglcomp="clr-namespace:ZusiMeterGaugesLib.Components;assembly=ZusiMeterGaugesLib"
        xmlns:g="clr-namespace:ZusiMeterGaugesLib.Gauges;assembly=ZusiMeterGaugesLib"
        xmlns:common="clr-namespace:ZusiMeterGaugesLib.Common"
        Title="TestPage" Height="450" Width="800">
  <Grid>
    <g:ControlLamp  Style="common:Styles.ControlLampRoundStyleKey" Color="White" Margin="0,0,1,1"
                           Content="E40" TextMode="True" On="{Binding RunningData.LME40, Mode=OneWay}"/>
  </Grid>
</Window>