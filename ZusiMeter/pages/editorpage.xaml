<UserControl x:Class="ZusiMeter.Pages.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ZusiMeter.Pages"
             xmlns:ctrls="clr-namespace:ZusiMeter.Controls"
             xmlns:gcv="clr-namespace:ZusiMeterGaugesLib.Converter;assembly=ZusiMeterGaugesLib"
             xmlns:common="clr-namespace:ZusiMeterGaugesLib.Common;assembly=ZusiMeterGaugesLib"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             x:Name="editorPage" Background="{DynamicResource NewBackgroundBrush}" SnapsToDevicePixels="true"
             UseLayoutRounding="true">
  <FrameworkElement.Resources>
    <gcv:Brush2ColorConverter x:Key="Brush2ColorConverter"/>
    <gcv:NeedleFaceTypeToListConverter x:Key="NeedleFaceTypeToListConverter"/>
    <gcv:NeedleFaceTypeToIntConverter x:Key="NeedleFaceTypeToIntConverter"/>
    <ImageBrush x:Key="PageBackgroundBrushKey"
                ImageSource="/ZusiMeter;component/Images/window_bkgnd_blue.png" Stretch="None"
                TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"/>
    <Style x:Key="FocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="2" SnapsToDevicePixels="true"
                       Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1"
                       StrokeDashArray="1 2"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070"/>
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#FF7E99A8"/>
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1"/>
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FFC4E5F6"/>
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF2C628B"/>
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4"/>
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5"/>
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383"/>
    <Style x:Key="VerticalButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Control.Background" Value="CornflowerBlue"/>
      <Setter Property="Control.BorderBrush" Value="AliceBlue"/>
      <Setter Property="Control.Foreground" Value="AntiqueWhite"/>
      <Setter Property="Control.BorderThickness" Value="1"/>
      <Setter Property="Control.HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Control.VerticalContentAlignment" Value="Center"/>
      <Setter Property="Control.Padding" Value="2,4"/>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="border" BorderBrush="{TemplateBinding Control.BorderBrush}"
                    BorderThickness="{TemplateBinding Control.BorderThickness}"
                    Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="true" CornerRadius="6">
              <TextBlock x:Name="contentPresenter" Focusable="false"
                         HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                         Margin="{TemplateBinding Control.Padding}"
                         SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                         VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                         TextWrapping="WrapWithOverflow" Text="{TemplateBinding ContentControl.Content}">
                <FrameworkElement.LayoutTransform>
                  <RotateTransform Angle="-90"/>
                </FrameworkElement.LayoutTransform>
              </TextBlock>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Button.IsDefaulted" Value="true">
                <Setter TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                        Property="Border.BorderBrush"/>
              </Trigger>
              <Trigger Property="UIElement.IsMouseOver" Value="true">
                <Setter TargetName="border" Value="{StaticResource Button.MouseOver.Background}"
                        Property="Border.Background"/>
                <Setter TargetName="border" Value="{StaticResource Button.MouseOver.Border}" Property="Border.BorderBrush"/>
              </Trigger>
              <Trigger Property="ButtonBase.IsPressed" Value="true">
                <Setter TargetName="border" Value="{StaticResource Button.Pressed.Background}" Property="Border.Background"/>
                <Setter TargetName="border" Value="{StaticResource Button.Pressed.Border}" Property="Border.BorderBrush"/>
              </Trigger>
              <Trigger Property="UIElement.IsEnabled" Value="false">
                <Setter TargetName="border" Value="{StaticResource Button.Disabled.Background}"
                        Property="Border.Background"/>
                <Setter TargetName="border" Value="{StaticResource Button.Disabled.Border}" Property="Border.BorderBrush"/>
                <Setter TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"
                        Property="TextElement.Foreground"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.242*"/>
      <ColumnDefinition Width="0.516*"/>
      <ColumnDefinition Width="0.242*"/>
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Row="1">
      <Border DockPanel.Dock="Top" Background="{DynamicResource CaptionBrush}">
        <Label x:Name="label" Content="Anzeigen • Melder • Baugruppen" Foreground="White"/>
      </Border>
      <Grid Background="#3F000000">
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TreeView x:Name="tvPalette" BorderThickness="0" Grid.Column="1" Grid.RowSpan="7"
                  ItemsSource="{Binding ToolBox, Mode=OneWay}" Background="{x:Null}">
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="{x:Type TreeViewItem}">
              <!--<Setter Property="TreeViewItem.IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>-->
              <Setter Property="TreeViewItem.IsExpanded" Value="False"/>
              <Setter Property="Control.Foreground" Value="WhiteSmoke"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Anything}" Value="True">
                  <Setter Property="Control.Background" Value="CornflowerBlue"/>
                  <Setter Property="Control.Foreground" Value="WhiteSmoke"/>
                  <Setter Property="Control.FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBold}" Value="True">
                  <Setter Property="Control.FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBold}" Value="False">
                  <Setter Property="Control.FontWeight" Value="Normal"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children, Mode=OneTime}">
              <ContentPresenter Margin="2" Content="{Binding DisplayName, Mode=OneTime}"/>
            </HierarchicalDataTemplate>
          </ItemsControl.ItemTemplate>
        </TreeView>
        <Button x:Name="btnCaption1" Command="{x:Static local:EditorPage.CommandCaption1}"
                Style="{DynamicResource VerticalButtonStyle}" CommandTarget="{Binding ElementName=editorPage}"
                Visibility="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>
        <Button x:Name="btnCaption2" Command="{x:Static local:EditorPage.CommandCaption2}" Grid.Row="1"
                Style="{DynamicResource VerticalButtonStyle}" CommandTarget="{Binding ElementName=editorPage}"
                Visibility="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>
        <Button x:Name="btnCaption3" Command="{x:Static local:EditorPage.CommandCaption3}" Grid.Row="2"
                Style="{DynamicResource VerticalButtonStyle}" CommandTarget="{Binding ElementName=editorPage}"
                Visibility="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>
        <Button x:Name="btnCaption4" Command="{x:Static local:EditorPage.CommandCaption4}" Grid.Row="3"
                Style="{DynamicResource VerticalButtonStyle}" CommandTarget="{Binding ElementName=editorPage}"
                Visibility="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>
        <Button x:Name="btnCaption5" Command="{x:Static local:EditorPage.CommandCaption5}" Grid.Row="4"
                Style="{DynamicResource VerticalButtonStyle}" CommandTarget="{Binding ElementName=editorPage}"
                Visibility="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>
        <Button x:Name="btnCaption6" Command="{x:Static local:EditorPage.CommandCaption6}" Grid.Row="5"
                Style="{DynamicResource VerticalButtonStyle}" CommandTarget="{Binding ElementName=editorPage}"
                Visibility="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>
        <Button x:Name="btnCaption7" Command="{x:Static local:EditorPage.CommandCaption7}" Grid.Row="6"
                Style="{DynamicResource VerticalButtonStyle}" CommandTarget="{Binding ElementName=editorPage}"
                Visibility="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>
      </Grid>
    </DockPanel>
    <GridSplitter HorizontalAlignment="Left" Width="5" Grid.Column="1" Grid.Row="1" Background="#00F0F0F0"/>
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  Margin="5,5,0,5" Grid.Row="1">
      <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
        <DockPanel HorizontalAlignment="Left" VerticalAlignment="Top">
          <DockPanel Dock="Top" Background="#FFF1EDED">
            <Image Height="16" Width="16"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0">
              <Path Data="M 0.5,0.5 L 10,0.5 " VerticalAlignment="Center" Stroke="Black" Margin="0,0,12,0"/>
              <Rectangle Height="10" Stroke="Black" Width="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5 " VerticalAlignment="Center" Stroke="Black"/>
            </StackPanel>
            <Label Content="ZusiMeter"/>
          </DockPanel>
          <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content=" "/>
          </StatusBar>
          <Border BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid x:Name="grdWorkspace" HorizontalAlignment="Left" VerticalAlignment="Top">
              <ctrls:LayoutGrid x:Name="placeholder" Width="200" Height="200" AllowDrop="true"/>
            </Grid>
            <FrameworkElement.LayoutTransform>
              <ScaleTransform CenterX="0" CenterY="0" ScaleX="{Binding Zoom, ElementName=placeholder, Mode=OneWay}"
                              ScaleY="{Binding Zoom, ElementName=placeholder, Mode=OneWay}"/>
            </FrameworkElement.LayoutTransform>
          </Border>
        </DockPanel>
      </Border>
    </ScrollViewer>
    <GridSplitter HorizontalAlignment="Left" Width="5" Grid.Column="2" Background="#00F0F0F0"/>
    <Grid Column="2" Background="AliceBlue" Margin="5,0,0,0"
          Visibility="{Binding IsEvilOS, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}">
      <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="3,36" FontWeight="Bold">
        <Run>
          Aufgrund von Einschränkungen,
        </Run>
        <LineBreak/>
        <Run>
          die für dein Betriebssystem gelten,
        </Run>
        <LineBreak/>
        <Run>
          können die Einstellungen nicht
        </Run>
        <LineBreak/>
        <Run>angezeigt werden.</Run>
      </TextBlock>
    </Grid>
    <Grid Column="2" Background="AliceBlue" Margin="5,0,0,0"
          Visibility="{Binding IsEvilOS, Mode=OneWay, Converter={StaticResource ReverseBoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <xctk:PropertyGrid ShowSortOptions="false" ShowSearchBox="false" Control.BorderThickness="0"
                    AutoGenerateProperties="false" SelectedObject="{Binding LayoutBackground, ElementName=placeholder}">
                <xctk:PropertyGrid.PropertyDefinitions>
                    <xctk:PropertyDefinition TargetProperties="Background"/>
        </xctk:PropertyGrid.PropertyDefinitions>
      </xctk:PropertyGrid>
      <DockPanel Grid.Row="1" Margin="0,5,0,0">
        <Label Background="#FFDDDDDD" DockPanel.Dock="Top" Padding="5,2,5,4" FontWeight="Bold"
               DataContext="{Binding SelectedGauge, ElementName=placeholder}" Content="{Binding GaugeName}"
               Visibility="{Binding Visibility, ElementName=pgGauge}"/>
                <xctk:PropertyGrid x:Name="pgGauge" ShowSortOptions="false" ShowSearchBox="false" Control.BorderThickness="0"
                      AutoGenerateProperties="false" ShowTitle="false">
          <FrameworkElement.Resources>
            <Style x:Key="GermanColorPickerStyle1" TargetType="{x:Type xctk:ColorPicker}">
              <Setter Property="xctk:ColorPicker.AvailableColorsHeader" Value="verfügbare Farben"/>
              <Setter Property="xctk:ColorPicker.StandardColorsHeader" Value="Standardfarben"/>
            </Style>
            <Style x:Key="GermanColorPickerStyle2" TargetType="{x:Type xctk:ColorPicker}"
                   BasedOn="{StaticResource GermanColorPickerStyle1}">
              <Setter Property="xctk:ColorPicker.StandardColorsHeader" Value="Standard-Zeigerfarben"/>
            </Style>
          </FrameworkElement.Resources>
          <xctk:PropertyGrid.EditorDefinitions>
            <xctk:EditorTemplateDefinition TargetProperties="Background,Foreground">
              <xctk:EditorTemplateDefinition.EditingTemplate>
                <DataTemplate>
                  <xctk:ColorPicker FrameworkElement.Style="{StaticResource GermanColorPickerStyle1}"
                               SelectedColor="{Binding Value, Converter={StaticResource Brush2ColorConverter}}"/>
                </DataTemplate>
              </xctk:EditorTemplateDefinition.EditingTemplate>
            </xctk:EditorTemplateDefinition>
            <xctk:EditorTemplateDefinition TargetProperties="NeedleColor">
              <xctk:EditorTemplateDefinition.EditingTemplate>
                <DataTemplate>
                  <xctk:ColorPicker FrameworkElement.Style="{StaticResource GermanColorPickerStyle2}"
                               SelectedColor="{Binding Value, Converter={StaticResource Brush2ColorConverter}}">
                    <xctk:ColorPicker.StandardColors>
                      <Binding Source="{x:Static common:StandardNeedleColors.Colors}"/>
                    </xctk:ColorPicker.StandardColors>
                  </xctk:ColorPicker>
                </DataTemplate>
              </xctk:EditorTemplateDefinition.EditingTemplate>
            </xctk:EditorTemplateDefinition>
            <xctk:EditorTemplateDefinition TargetProperties="NeedleFace">
              <xctk:EditorTemplateDefinition.EditingTemplate>
                <DataTemplate>
                  <xctk:PropertyGridEditorComboBox Selector.IsSynchronizedWithCurrentItem="True"
                                              Selector.SelectedIndex="{Binding Value, Converter={StaticResource NeedleFaceTypeToIntConverter}}"
                                              UIElement.IsEnabled="{Binding Instance.ClassicStyle}"
                                              ItemsControl.ItemsSource="{Binding PropertyType, Converter={StaticResource NeedleFaceTypeToListConverter}, Mode=OneWay}"/>
                </DataTemplate>
              </xctk:EditorTemplateDefinition.EditingTemplate>
            </xctk:EditorTemplateDefinition>
          </xctk:PropertyGrid.EditorDefinitions>
        </xctk:PropertyGrid>
      </DockPanel>
      <Border Grid.Row="2" Background="AliceBlue">
        <DockPanel Margin="6">
          <Label DockPanel.Dock="Top" Content="Zoom-Faktor des Fensters"/>
          <DockPanel Dock="Top" Margin="3,0">
            <TextBlock DockPanel.Dock="Left" Text="1x"/>
            <TextBlock DockPanel.Dock="Right" Text="3x"/>
            <TextBlock Text="2x" HorizontalAlignment="Center"/>
          </DockPanel>
          <Slider Minimum="1" Maximum="3" LargeChange="0.2" SmallChange="0.05" TickPlacement="TopLeft"
                  TickFrequency="0.5" Foreground="Black" Margin="3,0"
                  Value="{Binding Zoom, ElementName=placeholder, Mode=TwoWay}"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>