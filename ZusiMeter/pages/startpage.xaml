<UserControl x:Class="ZusiMeter.Pages.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:cm="clr-namespace:ZusiMeterGaugesLib.Common;assembly=ZusiMeterGaugesLib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ZusiMeter"
             xmlns:sl="clr-namespace:Sovoma.WPF.Converter;assembly=Sovoma.WPF"
             xmlns:zcv="clr-namespace:ZusiMeterGaugesLib.Converter;assembly=ZusiMeterGaugesLib"
             xmlns:zc="clr-namespace:ZusiMeterGaugesLib.Controls;assembly=ZusiMeterGaugesLib"
             xmlns:data="clr-namespace:ZusiMeter.Data" 
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=data:ToolBoxViewModel}"
             Background="{DynamicResource NewBackgroundBrush}" SnapsToDevicePixels="true"
             UseLayoutRounding="true">
  <FrameworkElement.Resources>
    <zcv:ExtractFilenameConverter x:Key="ExtractFilenameConverter"/>
    <sl:VersionStringConverter x:Key="VersionStringConverter"/>
    <Style BasedOn="{StaticResource DialogButtonStyle}" TargetType="{x:Type Button}">
      <Setter Property="ContentControl.Content"
              Value="{Binding Command.Text, RelativeSource={RelativeSource Self}}"/>
      <Setter Property="FrameworkElement.HorizontalAlignment" Value="Right"/>
      <Setter Property="Control.Padding" Value="12,3"/>
    </Style>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Border Padding="20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="270"/>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>
        <Label Content="Neues Layout anlegen" VerticalAlignment="Top" Grid.ColumnSpan="2" Foreground="WhiteSmoke"/>
        <Border Grid.Row="1" Background="#FF999999" BorderBrush="#FFABADB3" BorderThickness="1,1,0,1">
          <Image Stretch="None" Source="/ZusiMeter;component/Images/graphic.jpg"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Background="#FFBBBBB3" BorderBrush="#FFABADB3"
                BorderThickness="0,1,1,1">
          <Image Stretch="None" HorizontalAlignment="Center"
                 Source="/ZusiMeter;component/Images/textbased.jpg"/>
        </Border>
        <Button Command="{x:Static local:ZusiMeterControl.CommandNewGraphicLayout}" Grid.Row="3" Margin="0,5,48,1"/>
        <Button Command="{x:Static local:ZusiMeterControl.CommandNewTextLayout}" Grid.Row="3" Margin="0,6,0,0"
                Grid.Column="1"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Padding="20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="Layout öffnen" Foreground="WhiteSmoke"/>
        <ListView SelectionChanged="LvLayoutFiles_SelectionChanged" x:Name="lvLayoutFiles" Grid.Row="1" MaxWidth="440" SelectionMode="Single"
                  IsSynchronizedWithCurrentItem="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Background="#3E000000" ItemsSource="{Binding LayoutFiles}" SelectedItem="{Binding SelectedLayoutFile, Mode=TwoWay}" >
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="3,0,0,0" Width="64" ToolTip="{Binding Converter={StaticResource ExtractFilenameConverter}}">
                <Image Margin="0,0,0,3" HorizontalAlignment="Center" Stretch="None"
                       Source="/ZusiMeter;component/Images/listviewitem.png"/>
                <TextBlock HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{Binding Converter={StaticResource ExtractFilenameConverter}}"/>
                <StackPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Layout anzeigen" Command="{x:Static local:ZusiMeterControl.CommandLoadLayout}"/>
                    <MenuItem Header="Layout Bearbeiten" Command="{x:Static local:ZusiMeterControl.CommandLoadLayoutEdit}"/>
                    <MenuItem Header="Layout zu ZUSI-Autostart hinzufügen" Command="{x:Static local:ZusiMeterControl.CommandSendToAutoStart}"/>
                  </ContextMenu>
                </StackPanel.ContextMenu>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListView>
        <Button Command="{x:Static local:ZusiMeterControl.CommandLoadLayout}" Grid.Row="3" Grid.Column="0"
                Margin="0,6,0,0"/>
        <Button Command="{x:Static local:ZusiMeterControl.CommandLoadLayoutEdit}" Grid.Row="2" Grid.Column="0"
        Margin="0,6,266,0"/>
      </Grid>
    </Border>
    <Border Grid.Column="1" Padding="24,12,20,20" Grid.RowSpan="2">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition MinWidth="200">
          </ColumnDefinition>
          </Grid.ColumnDefinitions>

            <Border BorderThickness="1" BorderBrush="#FFABADB3" Grid.Row="2" Padding="3" Margin="0,12,0,0">
              <zc:LayoutPreview x:Name="preview" IsReadOnly="true">
                <FrameworkElement.LayoutTransform>
                  <ScaleTransform ScaleX="{Binding Zoom, RelativeSource={RelativeSource AncestorType={x:Type zc:LayoutPreview}}, Mode=OneWay}"
                              ScaleY="{Binding Zoom, RelativeSource={RelativeSource AncestorType={x:Type zc:LayoutPreview}}, Mode=OneWay}"/>
                </FrameworkElement.LayoutTransform>
              </zc:LayoutPreview>
            </Border>
            <!--<Button Command="{x:Static local:ZusiMeterControl.CommandBackToLayout}" VerticalAlignment="Bottom" Grid.Row="3"
                Margin="0,6,0,0"
                Visibility="{Binding HasLayout, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter={x:Static Visibility.Collapsed}}"/>-->
      </Grid>
    </Border>
  </Grid>
</UserControl>