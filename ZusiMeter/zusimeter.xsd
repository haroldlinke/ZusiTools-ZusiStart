	<!-- Analoge Instrumenttypen -->
	<xs:simpleType name="st_analoggaugetype">
		<xs:annotation>
			<xs:documentation>Analoge Instrumenttypen</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Accelerometer"/>
			<xs:enumeration value="Amperemeter"/>
			<xs:enumeration value="BrakeManometer"/>
			<xs:enumeration value="Dynamometer"/>
			<xs:enumeration value="FlowmeterA"/>
			<xs:enumeration value="FlowmeterB"/>
			<xs:enumeration value="Gauge"/>
			<xs:enumeration value="Gyrometer"/>
			<xs:enumeration value="Manometer"/>
			<xs:enumeration value="Tachometer"/>
			<xs:enumeration value="Torquemeter"/>
			<xs:enumeration value="Uhr"/>
			<xs:enumeration value="Voltmeter"/>
			<xs:enumeration value="Fahrstufe"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Digitale Instrumenttypen -->
	<xs:simpleType name="st_digitalgaugetype">
		<xs:annotation>
			<xs:documentation>Digitale Instrumenttypen</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="DigitalAccelerometer"/>
			<xs:enumeration value="DigitalAmperemeter"/>
			<xs:enumeration value="DigitalChronometer"/>
			<xs:enumeration value="DigitalDynamometer"/>
			<xs:enumeration value="DigitalFahrstufe"/>
			<xs:enumeration value="DigitalFahrschalter"/>
			<xs:enumeration value="DigitalFlowmeterA"/>
			<xs:enumeration value="DigitalFlowmeterB"/>
			<xs:enumeration value="DigitalGauge"/>
			<xs:enumeration value="DigitalGyrometer"/>
			<xs:enumeration value="DigitalIntern"/>
			<xs:enumeration value="DigitalManometer"/>
			<xs:enumeration value="DigitalNextStop"/>
			<xs:enumeration value="DigitalStreckenKm"/>
			<xs:enumeration value="DigitalTachometer"/>
			<xs:enumeration value="DigitalTorquemeter"/>
			<xs:enumeration value="DigitalVoltmeter"/>
			<xs:enumeration value="DigitalZugInfo"/>
			<!-- text ZugInfo type-->
			<xs:enumeration value="ZugInfoGauge">
				<xs:annotation>
					<xs:documentation>Darf nur für das Textinstrument verwendet werden.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<!-- special text watch type-->
			<xs:enumeration value="ChronometerGauge">
				<xs:annotation>
					<xs:documentation>Darf nur für ein Text-Uhr verwendet werden.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

	<!-- Horizontale Instrumenttypen -->
	<xs:simpleType name="st_horzgaugetype">
		<xs:annotation>
			<xs:documentation>Horizontale Instrumenttypen</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="HorizontalTachometerGauge"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Vertikale Instrumenttypen -->
	<xs:simpleType name="st_vertgaugetype">
		<xs:annotation>
			<xs:documentation>Vertikale Instrumenttypen</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="VerticalTachometerGauge"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Interaktive Instrumente -->
	<xs:simpleType name="st_operatortype">
		<xs:annotation>
			<xs:documentation>Interaktive Instrumente</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="RailRunner"/>
			<xs:enumeration value="SwitchPointInfo"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="st_doorsystems">
		<xs:annotation>
			<xs:documentation>Türsysteme</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="None"/>
			<xs:enumeration value="SAT"/>
			<xs:enumeration value="TB0"/>
			<xs:enumeration value="TB5"/>
			<xs:enumeration value="SST"/>
			<xs:enumeration value="TAV"/>
			<xs:enumeration value="UIC_WTB"/>
		</xs:restriction>
