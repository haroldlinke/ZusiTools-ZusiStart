	<!-- Aufzählung der ExtraGaugeStyles -->
	<xs:simpleType name="st_extragaugestyle">
		<xs:annotation>
			<xs:documentation>Aufzählung der ExtraGaugeStyles</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
