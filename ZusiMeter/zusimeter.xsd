			<xs:enumeration value="Currentx1000"/>
			<xs:enumeration value="Drehzahl"/>
			<xs:enumeration value="Drehzahlx100"/>
			<xs:enumeration value="Drehzahlx1000"/>
			<xs:enumeration value="Kraft"/>
			<xs:enumeration value="Kraftx100"/>
			<xs:enumeration value="Kraftx1000"/>
			<xs:enumeration value="Kraftx10000"/>
			<xs:enumeration value="Beschleunigung"/>
