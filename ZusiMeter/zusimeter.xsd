	<!-- Aufzählung der Indicator-Typen (Tachometer) -->
	<xs:simpleType name="st_indicator">
		<xs:annotation>
			<xs:documentation>Aufzählung der Indicator-Typen (Tachometer)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Off"/>
			<xs:enumeration value="TrackMaxSpeed"/>
			<xs:enumeration value="AFBTargetSpeed"/>
