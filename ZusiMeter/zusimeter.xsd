<?xml version="1.0" encoding="utf-8"?>
<!-- version 10.08.2018 -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

	<!-- ******************************************************************** -->
	<!-- simple types -->

	<!-- Hintergrundmodus -->
	<xs:simpleType name="st_backgroundmode">
		<xs:annotation>
			<xs:documentation>Hintergrundmodus</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="hammerEffect"/>
			<xs:enumeration value="burlwood"/>
			<xs:enumeration value="userimage"/>
			<xs:enumeration value="color"/>
			<xs:enumeration value="text"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Farbe eines Melders -->
	<xs:simpleType name="st_colorenum">
		<xs:annotation>
			<xs:documentation>Farbe eines Melders</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Red"/>
			<xs:enumeration value="Yellow"/>
			<xs:enumeration value="Green"/>
			<xs:enumeration value="Blue"/>
			<xs:enumeration value="White"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Zeigertyp -->
	<xs:simpleType name="st_needleface">
		<xs:annotation>
			<xs:documentation>Aussehen des Zeigers</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="Simple"/>
			<xs:enumeration value="VDO"/>
			<xs:enumeration value="Deuta"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Farbwert #FFFFFFFF -->
	<xs:simpleType name="st_color">
		<xs:annotation>
			<xs:documentation>Farbwert (z.B. #FFFFFFFF)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="#([0-9a-fA-F]{2}){4}"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Component-Typen -->
	<xs:simpleType name="st_componenttype">
		<xs:annotation>
			<xs:documentation>Component-Typen</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ComponentFahrtrichtung"/>
			<xs:enumeration value="ComponentTueren"/>
			<xs:enumeration value="ComponentNotbremssystem"/>
			<xs:enumeration value="ComponentSifa"/>
			<xs:enumeration value="ComponentStromabnehmer"/>
			<xs:enumeration value="ComponentZugbeeinflussungA"/>
      <xs:enumeration value="ComponentPZB_LZB"/>
			<xs:enumeration value="ComponentLZB"/>
      <xs:enumeration value="ComponentETCS"/>
			<xs:enumeration value="ComponentFahrsperre"/>
		</xs:restriction>
	</xs:simpleType>

