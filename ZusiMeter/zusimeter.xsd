	</xs:simpleType>

	<!-- Aufzählung DisplayModeType -->
	<xs:simpleType name="st_displaymode">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Graphic"/>
			<xs:enumeration value="Text"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- ******************************************************************** -->
	<!-- complex types -->

	<!-- Basistyp für Instrumente -->
	<xs:complexType name="ct_gauge_base">
		<xs:annotation>
			<xs:documentation>Basistyp für Instrumente</xs:documentation>
		</xs:annotation>
		<xs:attribute name="displayGroup" type="xs:string"/>
		<xs:attribute name="displayName" type="xs:string"/>
		<xs:attribute name="col" type="xs:int"/>
		<xs:attribute name="row" type="xs:int"/>
		<xs:attribute name="sizeX" type="xs:int" default="1"/>
		<xs:attribute name="sizeY" type="xs:int" default="1"/>
		<xs:attribute name="Background" type="xs:string"/>
		<xs:attribute name="Foreground" type="xs:string"/>
		<xs:attribute name="FtdID" type="st_gauge_id"/>
		<xs:attribute name="Name" type="xs:string"/>
		<xs:attribute name="Unit" type="st_unit"/>
		<xs:attribute name="ValueMultiplier" type="xs:double"/>
		<xs:attribute name="IsSteuerwagen" type="xs:boolean"/>
		<xs:attribute name="ClassicStyle" type="xs:boolean"/>
	</xs:complexType>

	<!-- Basistyp für Analoginstrumente -->
	<xs:complexType name="ct_analoggauge_base">
		<xs:annotation>
			<xs:documentation>Basistyp für Analoginstrumente</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="ct_gauge_base">
				<xs:attribute name="sizeX" type="xs:int" default="4"/>
				<xs:attribute name="LabelingFrequency" type="xs:unsignedInt"/>
				<xs:attribute name="Maximum" type="xs:double"/>
				<xs:attribute name="Minimum" type="xs:double"/>
				<xs:attribute name="SmallTickFrequency" type="xs:double"/>
				<xs:attribute name="TickFrequency" type="xs:double"/>
				<xs:attribute name="DefaultTheme" type="st_theme"/>
				<xs:attribute name="Theme" type="st_theme"/>
				<xs:attribute name="DialScale" type="xs:double"/>
				<xs:attribute name="Indicator" type="st_indicator"/>
				<xs:attribute name="SelectedMaximum" type="xs:unsignedInt"/>
				<xs:attribute name="NeedleColor" type="st_color"/>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<!-- Analoges Rundinstrument -->
	<xs:complexType name="ct_analoggauge">
		<xs:annotation>
			<xs:documentation>Analoges Rundinstrument</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="ct_analoggauge_base">
				<xs:attribute name="sizeY" type="xs:int" default="4"/>
				<xs:attribute name="type" type="st_analoggaugetype"/>
				<xs:attribute name="GaugeNameFontSize" type="xs:double"/>
				<xs:attribute name="HasDigitalDisplay" type="xs:boolean"/>
				<xs:attribute name="HasOverflowLED" type="xs:boolean"/>
				<xs:attribute name="HasPassepartout" type="xs:boolean"/>
				<xs:attribute name="NeedleFace" type="st_needleface"/>
				<xs:attribute name="NumDecimals" type="xs:unsignedInt"/>
				<xs:attribute name="SelectedVariant" type="xs:unsignedInt"/>
				<xs:attribute name="SuppressFirstTickLabel" type="xs:boolean"/>
				<xs:attribute name="DialStartAngle" type="xs:double"/>
				<xs:attribute name="DialEndAngle" type="xs:double"/>
				<xs:attribute name="DialStrokeThickness" type="xs:double"/>
