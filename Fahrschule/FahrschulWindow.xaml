<Window x:Class="ZusiCLIProject.Zusi3Fahrschule2.FahrschulWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZusiCLIProject.Zusi3Fahrschule2"
        mc:Ignorable="d"
        Title="Fahrschule" Height="678" Width="385">
    <Grid>
        <WebBrowser Name="webBrowser" Margin="0,28,0,0" Navigating="WebBrowser_Navigating" Grid.Row="1" Grid.Column="0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
      <TextBox Name="txtIp" HorizontalAlignment="Left" Height="23" Margin="10,0,0,0" TextWrapping="Wrap" Text="127.0.0.1" VerticalAlignment="Top" Width="98" Visibility="Collapsed"/>
      <TextBox Name="txtPort" HorizontalAlignment="Left" Height="23" Margin="10,0,0,0" TextWrapping="Wrap" Text="1436" VerticalAlignment="Top" Width="58" Visibility="Collapsed"/>
      <Button Name="btnConnect" Content="Verbinden" HorizontalAlignment="Left" Margin="10,1,0,0" VerticalAlignment="Top" Width="75" Click="BtnConnect_Click"/>
      <CheckBox Name="chbAutopause" Content="Automatische Pause" HorizontalAlignment="Left" Margin="10,7,0,0" VerticalAlignment="Top"/>
    </StackPanel>
  </Grid>
</Window>
