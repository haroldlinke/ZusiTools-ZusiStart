  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Überschrift -->
    <StackPanel Grid.Row="0" Margin="10">
      <TextBlock x:Name="TxtFahrplan"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"/>
      <TextBlock x:Name="TxtStation"
                   FontSize="14"
                   Margin="0,2,0,10"
                   Foreground="LightGray"/>
    </StackPanel>

    <!-- Canvas -->

  <ScrollViewer x:Name="Scroll"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"
                Grid.Row="1">

    <Grid x:Name="ZoomContainer">
      <Grid.LayoutTransform>
        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
      </Grid.LayoutTransform>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="40"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Zeitachse -->
        <Canvas x:Name="CanvasTop" Grid.Row="0" Grid.Column="1"/>

        <!-- Gleisnamen -->
        <Canvas x:Name="CanvasLeft" Grid.Row="1" Grid.Column="0"/>

        <!-- Hauptbereich -->
        <Canvas x:Name="CanvasMain" Grid.Row="1" Grid.Column="1"/>
      </Grid>
    </Grid>
  </ScrollViewer>
  </Grid>

</UserControl>

