<UserControl x:Class="ZusiStart.Controls.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZusiStart.Controls"
             MinHeight="20" MinWidth="40">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="20"/>
    </Grid.ColumnDefinitions>

    <TextBox x:Name="PART_TextBox"
             Grid.Column="0"
             VerticalContentAlignment="Center"
             HorizontalContentAlignment="Center"
             Padding="2"
             PreviewTextInput="PART_TextBox_PreviewTextInput"
             DataObject.Pasting="PART_TextBox_Pasting"
             LostFocus="PART_TextBox_LostFocus"
             PreviewKeyDown="PART_TextBox_PreviewKeyDown"
             PreviewMouseWheel="PART_TextBox_PreviewMouseWheel"
             MaxLength="{Binding MaxLength, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0">
      <RepeatButton x:Name="PART_ButtonUp" Content="▲" FontSize="8" Padding="0" Height="12"
                    Click="PART_ButtonUp_Click" Interval="120" Delay="300"/>
      <RepeatButton x:Name="PART_ButtonDown" Content="▼" FontSize="8" Padding="0" Height="12"
                    Click="PART_ButtonDown_Click" Interval="120" Delay="300"/>
    </StackPanel>
  </Grid>
</UserControl>  