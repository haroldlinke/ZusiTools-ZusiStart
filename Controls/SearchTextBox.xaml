<UserControl x:Class="ZusiStart.Controls.SearchTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZusiStart.Controls"
             mc:Ignorable="d"
             x:Name="stbx"
             d:DesignWidth="200" d:DesignHeight="30">
    <Border BorderThickness="1" BorderBrush="{DynamicResource Blue.Transparent.Background}" Background="{DynamicResource Bright.Transparent.Background}" CornerRadius="6" Padding="3"
            UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="tbx" BorderThickness="0" Background="{x:Null}" Text="{Binding Text, ElementName=stbx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
            <Button Grid.Column="1" Margin="3,0,0,0" Focusable="False" Click="Button_Click">
                <Path x:Name="eraser" Width="12" Height="12" StrokeThickness="2" StrokeEndLineCap="Triangle" StrokeStartLineCap="Triangle"
                      Stroke="{Binding Foreground, ElementName=tbx}"
                      Data="M0.5,0.5 L11.5,11.5 M11.5,0.5 L0.5,11.5"/>
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="{x:Null}"/>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
