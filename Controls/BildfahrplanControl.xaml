<UserControl x:Class="ZusiStart.Controls.BildfahrplanControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <!-- Button-Zeile -->
    <StackPanel Orientation="Horizontal" Margin="5">
      <Button Content="Bildfahrplan erzeugen"
                Padding="10,5"
                Click="OnGenerateBildfahrplan"/>
      <CheckBox x:Name="ChkFullPlan"
          Content="Fahrplanzeit nicht auf ausgewählten Zug einschränken"
          Margin="10"
          Checked="ChkFullPlan_Checked"
          Unchecked="ChkFullPlan_Unchecked"/>

    </StackPanel>

    <ScrollViewer x:Name="Scroll"
              Grid.Row="1"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"
              Background="#111">

      <!--<Grid x:Name="ScrollContent">

        --><!-- Gezoomte Ebene --><!--
        <Grid x:Name="ZoomContainer">
          <Grid.LayoutTransform>
            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
          </Grid.LayoutTransform>

          <Grid x:Name="RootGrid" ClipToBounds="True" Background="#111"
                  MouseDown="RootGrid_MouseDown"
                  MouseMove="RootGrid_MouseMove"
                  MouseUp="RootGrid_MouseUp">-->
            <Canvas x:Name="PlanCanvas" Background="#111"/>
      <!--<Canvas x:Name="PlanCanvas" Background="White"/>-->
          <!--</Grid>
        </Grid>

        --><!-- NICHT gezoomte Ebene --><!--
        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                IsHitTestVisible="False"
                Panel.ZIndex="10"/>
      </Grid>-->
    </ScrollViewer>


  </Grid>


</UserControl>
