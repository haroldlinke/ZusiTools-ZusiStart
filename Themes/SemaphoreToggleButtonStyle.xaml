<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cv="clr-namespace:ZusiStart.Converter">

    <!-- Semaphore Toggle Button -->
    <cv:AngleConverter x:Key="AngleConverter"/>
    <SolidColorBrush x:Key="Semaphore.Edge" Color="#FFCF2C36"/>
    <SolidColorBrush x:Key="Semaphore.Background" Color="GhostWhite"/>

    <Style x:Key="SemaphoreToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent">
                        <Path x:Name="ptSemaphore" Fill="{DynamicResource Semaphore.Background}" Stroke="{DynamicResource Semaphore.Edge}" StrokeThickness="3" RenderTransformOrigin="0.08,0.5" Margin="5,27,0,0"
                              Data="M0.5,4.5 H28.5 A8,8 210 1 1 28.5,12.5 H0.5 Z M28.5,12.5 A8,8 30 0 1 28.5,4.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AngleConverter}, Mode=OneWay}"/>
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ptSemaphore" Property="Stroke" Value="Gray"/>
                        </Trigger>
                        <EventTrigger RoutedEvent="Checked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Duration="0:0:1.000" Storyboard.TargetName="ptSemaphore"  Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="-45">
                                        <DoubleAnimation.EasingFunction>
                                            <ElasticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Unchecked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Duration="0:0:1.000" Storyboard.TargetName="ptSemaphore" Storyboard.TargetProperty="RenderTransform.Angle" From="-45" To="0">
                                        <DoubleAnimation.EasingFunction>
                                            <ElasticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>