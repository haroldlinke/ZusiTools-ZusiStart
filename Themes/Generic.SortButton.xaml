<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ZusiStart.Controls">

    <Style TargetType="{x:Type local:SortButton}">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SortButton}">
                    <Grid>
                        <Ellipse x:Name="ball" Fill="{TemplateBinding Background}" Margin="2"/>
                        <Path x:Name="arrow" Fill="Black" Data="M0.5,11.5H12.5L6.5,0.5Z"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortMode" Value="None">
                            <Setter TargetName="arrow" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ball" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="SortMode" Value="Ascending">
                            <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ball" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="arrow" Property="Data" Value="M0.5,11.5H12.5L6.5,0.5Z"/>
                        </Trigger>
                        <Trigger Property="SortMode" Value="Descending">
                            <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ball" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="arrow" Property="Data" Value="M0.5,0.5H12.5L6.5,11.5Z"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>