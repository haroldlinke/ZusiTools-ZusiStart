<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrls="clr-namespace:ZusiStart.Controls"
                    xmlns:cv="clr-namespace:ZusiStart.Converter"
                    xmlns:data="clr-namespace:ZusiStart.Data">

  <data:JourneyTimeConverter x:Key="JourneyTimeConverter"/>
  <data:StartTimeConverter x:Key="StartTimeConverter"/>
  <data:ViewSourceConverter x:Key="ViewSourceConverter"/>
  

  <Style x:Key="TrainViewExpanderButtonStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Height" Value="10"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="Gold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border>
            <Path x:Name="arrow" Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" 
                              Fill="#00FFFFFF" Data="M0.5,0.5L5,5L0,9.5Z"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource Bright.Transparent.Background}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="arrow" Property="Data" Value="M0.5,8.5L6.5,2.5V8.5Z"/>
              <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource Bright2.Transparent.Background}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TrainViewItemContainerStyle" TargetType="{x:Type TreeViewItem}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="BorderBrush" Value="Gold"/>
    <Setter Property="Foreground" Value="{DynamicResource Generic.Foreground}"/>
    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
    <Setter Property="Tag" Value="{x:Static Visibility.Collapsed}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TreeViewItem}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition MinWidth="19" Width="auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ToggleButton x:Name="expander"
                                      Style="{StaticResource TrainViewExpanderButtonStyle}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
            <Border x:Name="brd"
                                Grid.Column="1"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
              <DockPanel>
                <ctrls:SortButton x:Name="sort" DockPanel.Dock="Right" Margin="0,0,24,0" Visibility="{TemplateBinding Tag}"/>
                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              </DockPanel>
            </Border>
            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Hervorhebung beim Überfahren mit der Maus -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="brd" Property="Background" Value="{DynamicResource Bright2.Transparent.Background}"/>
              <Setter Property="Foreground" Value="Black"/>
            </Trigger>
            <!-- ausgewähltes Element -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True"/>
                <Condition Property="IsFocused" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="brd" Property="Background" Value="{DynamicResource Bright.Transparent.Background}"/>
              <Setter TargetName="brd" Property="BorderThickness" Value="1"/>
              <Setter TargetName="brd" Property="Margin" Value="-1"/>
              <Setter Property="Foreground" Value="Black"/>
            </MultiTrigger>
            <!-- nicht ausgeklapptes Element -->
            <Trigger Property="IsExpanded" Value="False">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <!-- ausgeklapptes Element -->
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="expander" Property="Visibility" Value="Hidden"/>
            </Trigger>
            <!-- ?? -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="HasHeader" Value="False"/>
                <Condition Property="Width" Value="Auto"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_Header" Property="MinWidth" Value="19"/>
            </MultiTrigger>
            <!-- ?? -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="HasHeader" Value="False"/>
                <Condition Property="Height" Value="Auto"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_Header" Property="MinHeight" Value="19"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <Setter Property="ContextMenu">
      <Setter.Value>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="Mark as Favorite" 
                  Command="{Binding MarkAsFavoriteCommand}"
                  CommandParameter="{Binding}"/>
          <MenuItem Header="Unmark Favorite" 
                  Command="{Binding UnmarkFavoriteCommand}"
                  CommandParameter="{Binding}"/>
        </ContextMenu>
      </Setter.Value>
    </Setter>
    
    <Style.Triggers>
      <!-- Abschnittsüberschrift -->
      <DataTrigger Binding="{Binding IsBold}" Value="True">
        <Setter Property="FontWeight" Value="Bold"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsBold}" Value="False">
        <Setter Property="FontWeight" Value="Normal"/>
      </DataTrigger>
      <!-- Dekozug markieren -->
      <DataTrigger Binding="{Binding IsDecoTrain}" Value="True">
        <Setter Property="FontStyle" Value="Italic"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsDecoTrain}" Value="False">
        <Setter Property="FontStyle" Value="Normal"/>
      </DataTrigger>
      <!-- Sortierbutton -->
      <DataTrigger Binding="{Binding HasSortButton}" Value="True">
        <Setter Property="Tag" Value="{x:Static Visibility.Visible}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding HasSortButton}" Value="False">
        <Setter Property="Tag" Value="{x:Static Visibility.Collapsed}"/>
      </DataTrigger>
      <!-- Abschnitt, der nur Dekozüge enthält, ausblenden -->
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}" Value="False"/>
          <Condition Binding="{Binding IsBold}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Visibility" Value="Collapsed"/>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <HierarchicalDataTemplate x:Key="TrainViewItemTemplate" ItemsSource="{Binding Children, Converter={StaticResource ViewSourceConverter}}">
    <DockPanel Margin="2">
      <!--<DockPanel.ToolTip>
        <ToolTip>
          <TextBlock Text="{Binding Comment2}" />
        </ToolTip>
      </DockPanel.ToolTip>-->
      <!--<ToggleButton x:Name="expander"
                          Style="{StaticResource TrainViewExpanderButtonStyle}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press"/>-->
      <Path DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" Fill="{Binding FavoriteFill}"
            Data="M10,1 L12.5,6.5 L18.5,7 L14,11 L15.5,17 L10,14 L4.5,17 L6,11 L1.5,7 L7.5,6.5 Z"/>
      <TextBlock DockPanel.Dock="Left" Text="{Binding StartTime, Converter={StaticResource StartTimeConverter}}" Margin="0,0,6,0"/>
      <TextBlock DockPanel.Dock="Right" Text="{Binding JourneyTime, Converter={StaticResource JourneyTimeConverter}}" Margin="20,0,20,0"/>
      <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
      
    </DockPanel>
  </HierarchicalDataTemplate>

  <Style x:Key="TrainViewStyle" TargetType="{x:Type TreeView}">
    <Setter Property="Background" Value="{x:Null}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Generic.Foreground}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource TrainViewItemContainerStyle}"/>
    <Setter Property="ItemTemplate" Value="{StaticResource TrainViewItemTemplate}"/>
  </Style>
</ResourceDictionary>