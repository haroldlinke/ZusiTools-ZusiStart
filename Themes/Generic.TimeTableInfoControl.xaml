                  </Label>
                  <StackPanel DockPanel.Dock="Right" x:Name="SMALL_PicsPanel" Orientation="Horizontal" Width="auto" Background="White" HorizontalAlignment="Right" Margin="6,0,0,0"/>

                </DockPanel>
              </Border>
              <Grid Grid.Row="1" Margin="0,1,0,1">
                <local:BeadsControl Foreground="{DynamicResource TimeTableInfoControl3.Beads}" DotBrush="Gray" HorizontalAlignment="Center"
