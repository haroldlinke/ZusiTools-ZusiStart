<Window x:Class="ZusiStart.CreatePictures.CreatePicturesDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZusiStart.CreatePictures"
        xmlns:s="clr-namespace:Sovoma;assembly=Sovoma"
        xmlns:b="clr-namespace:Sovoma.ControlsKit.Behaviors;assembly=Sovoma.ControlsKit"
        xmlns:sl="clr-namespace:Sovoma.WPF.Converter;assembly=Sovoma.WPF"      
        mc:Ignorable="d"
        b:DialogBehavior.IsDialog="True"
        Title="CreatePictures" UseLayoutRounding="True" SnapsToDevicePixels="True" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight" MaxWidth="650" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="{x:Null}">

  <Window.Resources>
    <sl:VersionStringConverter x:Key="VersionStringConverter"/>
  </Window.Resources>

  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="(Window.Opacity)" From="0.0" To="1.0" Duration="0:0:0:0.600" AutoReverse="False" RepeatBehavior="1x"/>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>

  <Border Padding="12,0,12,6" CornerRadius="6" Background="{DynamicResource Bright.Transparent.Background}" BorderBrush="Goldenrod" BorderThickness="6,2">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
      </Grid.RowDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="48" FontWeight="Bold" FontStyle="Italic" Foreground="#FFBBBD93"
                           Text="Zusi Fahrzeugbilder">
          <TextBlock.Effect>
            <DropShadowEffect/>
          </TextBlock.Effect>
        </TextBlock>

      </Grid>

      <TextBlock  HorizontalAlignment="Center" TextWrapping="Wrap" Grid.Row="1" Margin="0,12,0,0">
                Erstelle alle Fahrzeugbilder im Cache
      </TextBlock>
      <StackPanel Grid.Row="3" Margin="20">
        <ProgressBar x:Name="progressBar" Height="30" Maximum="100" />
        <TextBlock x:Name="percentageText" FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,0"/>

      </StackPanel>
      <Button Content="Start Fahrzeugbilderstellung" Click="StartProgress_Click" Margin="0,12,0,6" Style="{DynamicResource ZusiStartButtonStyle}" Grid.Row="4" HorizontalAlignment="Left" IsDefault="True"/>
      <Button Command="{x:Static local:CreatePicturesDlg.CommandClose}" Content="{Binding Command.Text, RelativeSource={RelativeSource Self}}" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="4" 
                    Style="{DynamicResource ZusiStartButtonStyle}"  Margin="0,12,0,6"/>
    </Grid>
  </Border>
</Window>
