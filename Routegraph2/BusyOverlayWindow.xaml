<Window x:Class="Z8Routegraph2n.BusyOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:ZusiStart.Data"
        xmlns:local="clr-namespace:Z8Routegraph2n"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#80000000"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="300" Height="100"
        Topmost="True">
  <Border CornerRadius="8" Background="Gray" Padding="20">
    <TextBlock Text="{Binding Message}"
                   Foreground="White"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
               TextWrapping="Wrap"/>
  </Border>
</Window>
