<Application x:Class="ZusiStart.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZusiStart"
             xmlns:adctrl="https://github.com/Dirkster99/AvalonDock"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ZusiMeterGaugesLib;component/Themes/Generic.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/ZusiMeterGaugesLib;component/Themes/Generic.Knob.xaml"/>
        <!--<ResourceDictionary Source="pack://application:,,,/Sovoma.ControlsKit;component/Themes/Generic.xaml"/>-->
        <!--<ResourceDictionary Source="pack://application:,,,/ZusiMeter;component/Themes/Generic.xaml"/>-->
        <ResourceDictionary Source="pack://application:,,,/ZusiMeterGaugesLib;component/Themes/Generic.Include.xaml"/>
        <ResourceDictionary Source="/ZusiStart;component/Themes/Generic.xaml"/>
        <ResourceDictionary Source="/ZusiStart;component/Themes/Generic.MessageBox.xaml"/>
        <ResourceDictionary Source="/ZusiStart;component/Themes/Generic.SortButton.xaml"/>
        <ResourceDictionary Source="/ZusiStart;component/Themes/Generic.MultiButtonControl.xaml"/>
        <ResourceDictionary Source="/ZusiStart;component/Themes/Generic.DecoTrainsButton.xaml"/>
        <ResourceDictionary Source="/ZusiStart;component/Themes/Generic.TrainView.xaml"/>
        <ResourceDictionary Source="/ZusiStart;component/Themes/Generic.BeadsControl.xaml"/>
        <ResourceDictionary Source="/ZusiStart;component/Themes/Generic.TimeTableInfoControl.xaml"/>
        <ResourceDictionary Source="/ZusiStart;component/Themes/Generic.TimeTableOverviewControl.xaml"/>
        <ResourceDictionary Source="/ZusiStart;component/Themes/SemaphoreToggleButtonStyle.xaml"/>
        
      </ResourceDictionary.MergedDictionaries>
      <!-- Dokument-Tabs --><!--
      <Style TargetType="{x:Type adctrl:LayoutDocumentTabItem}">
        <Setter Property="Foreground" Value="White"/>
      </Style>

      --><!-- Anchorable-Tabs --><!--
      <Style TargetType="{x:Type adctrl:LayoutAnchorableTabItem}">
        <Setter Property="Foreground" Value="White"/>
      </Style>-->

      <!-- Dokument-Pane -->
      <Style TargetType="{x:Type adctrl:LayoutDocumentPaneControl}">
        <Setter Property="Background" Value="DarkBlue"/>
      </Style>

      <!-- Anchorable-Pane -->
      <!--<Style TargetType="{x:Type adctrl:LayoutAnchorablePaneControl}">
        <Setter Property="Background" Value="DarkBlue"/>
      </Style>-->

      <Style TargetType="{x:Type adctrl:LayoutAnchorableControl}">
        <Setter Property="Foreground" Value="White"/>
      </Style>

      <!-- Fensterpositions-Button verstecken -->
      <Style TargetType="Button" x:Key="HideDockButton">
        <Setter Property="Visibility" Value="Collapsed"/>
      </Style>

    </ResourceDictionary>
    

  </Application.Resources>
</Application>
