<Window x:Class="ZusiStart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZusiStart"
        xmlns:cv="clr-namespace:ZusiStart.Converter"
        xmlns:ctrls="clr-namespace:ZusiStart.Controls" 
        xmlns:data="clr-namespace:ZusiStart.Data"
        xmlns:zg="clr-namespace:ZusiMeterGaugesLib.Gauges;assembly=ZusiMeterGaugesLib"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:s="clr-namespace:Sovoma;assembly=Sovoma"
        xmlns:sw="clr-namespace:Sovoma.WPF.Converter;assembly=Sovoma.WPF"
        xmlns:WpF="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:gmaps="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        mc:Ignorable="d"
        x:Name="window" 
        Background="{DynamicResource bkgnd0}"
        MinWidth="1500"
        MinHeight="700"
        DataContext="{Binding Source={x:Static data:DataManager.Instance}}"
        Title="Zusi • Fahrplanauswahl" SnapsToDevicePixels="True" UseLayoutRounding="True" 
        ResizeMode="CanResize" 
        WindowState="Maximized" 
        Icon="zusistart.ico"
        WindowStyle="SingleBorderWindow">

  <Window.Resources>
    <cv:EpocheToStringConverter x:Key="EpocheToStringConverter"/>
    <cv:ColWidthConverter x:Key="ColWidthConverter"/>
    <cv:GridSizeConverter x:Key="GridSizeConverter"/>
    <cv:TimeTableRelationConverter x:Key="TimeTableRelationConverter"/>
    <cv:HalfValueConverter x:Key="HalfValueConverter"/>
    <cv:StreckenkarteButtonVisibilityConverter x:Key="StreckenkarteButtonVisibilityConverter"/>
    <cv:LaNrVisibilityConverter x:Key="LaNrVisibilityConverter"/>
    <sw:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>



    <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="brd" Padding="0" CornerRadius="6" BorderThickness="2">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="brd" Property="BorderBrush" Value="Gold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--<CollectionViewSource x:Key="PassengerTrains" Source="{Binding TimeTableTrains}" Filter="PassengerTrains_Filter"/>-->
    <CollectionViewSource x:Key="PassengerTrains" Source="{Binding TimeTableTrains}" Filter="GeneralTrains_Filter"/>
    <CollectionViewSource x:Key="FreightTrains" Source="{Binding TimeTableTrains}" Filter="FreightTrains_Filter"/>
    <CollectionViewSource x:Key="FoundPassengerTrains" Source="{Binding FoundTrains}" Filter="PassengerTrains_Filter"/>
    <CollectionViewSource x:Key="FoundFreightTrains" Source="{Binding FoundTrains}" Filter="FreightTrains_Filter"/>

    <DataTemplate x:Key="WebViewTemplate">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Button Panel -->
        <!--<StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
          <Button Content="Zoom In" Click="ZoomIn_Click" Visibility="{Binding Title, Converter={StaticResource StreckenkarteButtonVisibilityConverter}}"/>
          <Button Content="Zoom Out" Click="ZoomOut_Click" Visibility="{Binding Title, Converter={StaticResource StreckenkarteButtonVisibilityConverter}}"/>
          <Button Content="Full Screen" Click="ResetView_Click" Visibility="{Binding Title, Converter={StaticResource StreckenkarteButtonVisibilityConverter}}"/>

        </StackPanel>-->
        <!-- WebView -->
        <ContentControl Content="{Binding WebViewInstance}" Grid.Row="1"/>
      </Grid>
    </DataTemplate>

    <!-- **** Intro-Tab **** -->
    <DataTemplate x:Key="IntroTemplate">
      <TextBlock Text="Willkommen zur Zusi MultiTab-Anwendung! 
Hier können Sie verschiedene Dokumente, Karten und Webseiten in separaten Tabs anzeigen. 
Wählen Sie einfach einen Tab aus, um loszulegen." FontSize="16" Margin="10" TextWrapping="Wrap"/>

    </DataTemplate>

    <!-- **** Buchfahrplan Image-Tab **** -->
    <DataTemplate x:Key="ImageTemplate">
      <DockPanel>
        <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Image x:Name="buchfahrplanImage"
       Stretch="None"
       Visibility="Visible"
       Source="{Binding ImageSource}" />
        </ScrollViewer>
      </DockPanel>
    </DataTemplate>


    <!-- **** Favorites List-Tab **** -->
    <DataTemplate x:Key="ListTemplate">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
          <Button Command="{x:Static local:MainWindow.AddFavoriteTrainCommand}" CommandTarget="{Binding ElementName=window}" Content="{Binding Command.Text, RelativeSource={RelativeSource Self}}" Style="{DynamicResource DialogButtonStyle}" Margin="6,6,6,6"/>
          <Button Command="{x:Static local:MainWindow.DelFavoriteTrainCommand}" CommandTarget="{Binding ElementName=window}" Content="{Binding Command.Text, RelativeSource={RelativeSource Self}}" Style="{DynamicResource DialogButtonStyle}" Margin="6,6,6,6"/>
          <Button Command="{x:Static local:MainWindow.StartFavTrainCommand}" Content="{Binding Command.Text, RelativeSource={RelativeSource Self}}" Style="{DynamicResource DialogButtonStyle}" Margin="6,6,6,6"/>
          <Button Command="{x:Static local:MainWindow.EditFavoriteCommentCommand}" Content="{Binding Command.Text, RelativeSource={RelativeSource Self}}" Style="{DynamicResource DialogButtonStyle}" Margin="6,6,6,6" HorizontalAlignment="Right"/>
        </StackPanel>
        <Border x:Name="brdRecent" Panel.ZIndex="1" Background="{DynamicResource Blue.Transparent.Background}" CornerRadius="6" Padding="0,1,0,3"
              Visibility="Visible" >
          <ListBox BorderThickness="0" Background="Transparent"
                   ItemsSource="{Binding RecentTrains}"
                   SelectedItem="{Binding SelectedRecentTrain, Mode=TwoWay}"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Resources>
              <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Background" Value="{DynamicResource Bright.Transparent.Background}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                      <Border x:Name="brd" BorderBrush="{DynamicResource Blue.Transparent.Background}" BorderThickness="1" CornerRadius="6" Padding="0" Margin="2,0,2,3">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <!--<Setter Property="Background" TargetName="brd" Value="{DynamicResource Bright2.Transparent.Background}"/>-->
                          <Setter Property="Background" TargetName="brd" Value="{DynamicResource Bright2.Transparent.Background}"/>
                          <Setter Property="BorderBrush" TargetName="brd" Value="Gold"/>
                          <Setter Property="BorderThickness" TargetName="brd" Value="4"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" TargetName="brd" Value="{DynamicResource Bright2.Transparent.Background}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.Resources>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <ctrls:TimeTableInfoControl3 Source="{Binding Train}" UseCounter="{Binding Used}" TimeTableName="{Binding TimeTableName}" Comment="{Binding Comment, Mode=TwoWay}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>
    </DataTemplate>


    <!-- **** Tab Content Selector **** -->
    <local:TabContentTemplateSelector x:Key="TabSelector"
                                      WebViewTemplate="{StaticResource WebViewTemplate}"
                                      IntroTemplate="{StaticResource IntroTemplate}"
                                      ImageTemplate="{StaticResource ImageTemplate}"
                                      ListTemplate="{StaticResource ListTemplate}"/>
  </Window.Resources>

  <!--<Window.InputBindings>
    <KeyBinding Key="A" Modifiers="Control" Command="{Binding FocusListTimeTableGrpCommand}" />
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding FocusListTimeTablesCommand}" />
    <KeyBinding Key="C" Modifiers="Control" Command="{Binding FocusListtvPassengerTrainsCommand}" />
    <KeyBinding Key="D" Modifiers="Control" Command="{Binding FocusListFilterCommand}" />
  </Window.InputBindings>-->


  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300*"/>
      <ColumnDefinition Width="1273*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="auto"/>
    </Grid.RowDefinitions>

    <!-- **** Main Menue **** -->
    <Menu VerticalAlignment="Center" Grid.ColumnSpan="2" Padding="0,0" Visibility="Visible">
      <Control.Background>
        <LinearGradientBrush>
          <GradientStop Offset="0" Color="#FF76A8FF"/>
          <GradientStop Offset="1" Color="#FF6A9BF3"/>
        </LinearGradientBrush>
      </Control.Background>
      <MenuItem Header="_Tools">
        <MenuItem Command="{x:Static local:MainWindow.CommandOptions}"/>
        <MenuItem Command="{x:Static local:MainWindow.TrainStartSettingsCommand}"/>

        <MenuItem Command="{x:Static local:MainWindow.CommandCreatePictures}"/>
        <MenuItem Command="{x:Static local:MainWindow.CommandQuit}"/>
      </MenuItem>
      <MenuItem Header="_Info">
        <MenuItem Command="{x:Static local:MainWindow.CommandAbout}"/>
        <!--<MenuItem Command="{x:Static local:MainWindow.CommandHelp}"/>
        <MenuItem Command="{x:Static local:MainWindow.CommandExtDocu}"/>-->
      </MenuItem>
      <!--<MenuItem Header="_Zugtausch">
        <MenuItem Command="{x:Static local:MainWindow.UndoReplTrainCommand}"/>
        <MenuItem Command="{x:Static local:MainWindow.ManageReplTrainsCommand}"/>
      </MenuItem>-->
    </Menu>
    <!--<Rectangle x:Name="rctMask" Fill="Black" Opacity="0.66" IsHitTestVisible="False" Panel.ZIndex="3" Visibility="Visible" d:IsHidden="True" Grid.ColumnSpan="2" Margin="0,0,0,455" Grid.RowSpan="2"/>-->

    <Grid x:Name="mainGrid" Grid.Row="1" VerticalAlignment="Top" Grid.ColumnSpan="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="21*"/>
        <RowDefinition Height="202*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ==================================== Fahrplanauswahl ==================================== -->
      <Border x:Name="brdMain" Visibility="{Binding MainBorderVisibility, ElementName=window}" d:IsHidden="True" Grid.RowSpan="2">
        <!--<Border x:Name="brdMain" Visibility="Visible" Panel.ZIndex="1" Grid.RowSpan="2">-->
        <Grid Cursor="">
          <Grid.ColumnDefinitions>
            <!--<ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="768"/>
            <ColumnDefinition Width="6*"/>-->
            <ColumnDefinition Width="2*" />
            <ColumnDefinition MinWidth="1024" Width="6*"/>
            <ColumnDefinition Width="2*"/>
          </Grid.ColumnDefinitions>
          <GridSplitter Grid.Column="0" Background="Black" Width="5"/>
          <GridSplitter Grid.Column="1" Background="Black" Width="5" Cursor="SizeWE"/>
          <Border x:Name="brdTimeTablesGrp" Background="{DynamicResource Blue.Transparent.Background}" CornerRadius="6" Margin="0,0,3,0" Padding="3">
            <GroupBox Header="Fahrplangruppen" Foreground="White" BorderThickness="1" BorderBrush="WhiteSmoke" Grid.Row="1" Margin="1,0,1,1">

              <ListBox x:Name="ListTimeTableGrp" BorderThickness="0" Background="{x:Null}" IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding GroupedTimeTables}" ScrollViewer.HorizontalScrollBarVisibility="Visible" 
                     HorizontalContentAlignment="Center" ItemContainerStyle="{StaticResource ListBoxItemStyle}" PreviewGotKeyboardFocus="ListBox_PreviewGotKeyboardFocus"
                     SelectionChanged="SelectedTimeTableChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <ctrls:TimeTableOverviewControl x:Name="toc" Source="{Binding}" SelectedTimeTableChanged="TimeTableOverviewControl_SelectedTimeTableChanged"
                                                  IsSelected="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Mode=TwoWay}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </GroupBox>
          </Border>
          <Border x:Name="brdBrowser" Grid.Column="1" Background="{DynamicResource Blue.Transparent.Background}" Margin="3,0" CornerRadius="6" Padding="6" Visibility="Visible">
            <!--<Border x:Name="brdBrowser" Grid.Column="1" Background="{DynamicResource Blue.Transparent.Background}" Margin="1,0,1,0" CornerRadius="6" Padding="4"
                  Visibility="{Binding SelectedTimeTableRelation, ConverterParameter={x:Static Visibility.Hidden}, Converter={StaticResource TimeTableRelationConverter}}">-->
            <DockPanel>
              <Grid DockPanel.Dock="Top" >
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Visibility="Collapsed">
                  <TextBox Name="FoundTimeTableGroup" IsReadOnly="True" Width="300" >
                    <TextBox.Text>
                      <MultiBinding Converter="{StaticResource StringFormatMultiConverter}" ConverterParameter="Fahrplangruppe: {0}" Mode="OneWay">
                        <Binding Path="FoundTimeTableGroupTitle"/>
                      </MultiBinding>
                    </TextBox.Text>
                  </TextBox>
                </StackPanel>
                <!--<Border Visibility="{Binding Relations.Count, ConverterParameter=0, Converter={StaticResource CountToVisibilityConverter}, Mode=OneWay}" BorderThickness="1" BorderBrush="WhiteSmoke" Grid.Row="1" Margin="1,5,1,5">-->

                <Expander Header="Fahrpläne" IsExpanded="True" Margin="1">
                  <Expander.Style>
                    <Style TargetType="Expander">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Expander">
                            <GroupBox Header="Fahrpläne" Foreground="White" BorderThickness="1" BorderBrush="WhiteSmoke" Grid.Row="1" Margin="1,0,1,1">
                              <WrapPanel Orientation="Horizontal">
                                <!-- Header mit Toggle -->
                                <ToggleButton
                                              Style="{StaticResource TrainViewExpanderButtonStyle}"
                                              Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              FontWeight="Bold"
                                              Background="LightGray"
                                              BorderThickness="0"
                                              Padding="5" VerticalAlignment="Top"/>
                                <!-- Inhalt -->
                                <ContentPresenter Visibility="{TemplateBinding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Margin="5"/>
                              </WrapPanel>
                            </GroupBox>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </Expander.Style>

                  <!-- Beispielinhalt -->
                  <!--
                  <StackPanel>
                    <TextBlock Text="Inhalt 1"/>
                    <TextBlock Text="Inhalt 2"/>
                  </StackPanel>-->

                  <!--<GroupBox Header="Fahrpläne" Foreground="White" BorderThickness="1" BorderBrush="WhiteSmoke" Grid.Row="1" Margin="1,0,1,1">-->

                  <WrapPanel Orientation="Horizontal">

                    <ListBox x:Name="ListTimeTables" ItemsSource="{Binding Relations}" SelectedItem="{Binding SelectedTimeTableRelation}" BorderThickness="0" Margin="1,0,0,1" Background="{x:Null}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" IsSynchronizedWithCurrentItem="True" 
                             Visibility="{Binding Relations.Count, ConverterParameter=0, Converter={StaticResource CountToVisibilityConverter}, Mode=OneWay}"
                             SelectionChanged="SelectedTimeTableRelationChanged2">
                      <ListBox.Resources>
                        <Style TargetType="{x:Type ListBoxItem}">
                          <Setter Property="Background" Value="{x:Null}"/>
                          <Setter Property="Foreground" Value="{DynamicResource Generic.Foreground}"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="brd" Background="blue" BorderBrush="White" BorderThickness="1" CornerRadius="0" Padding="3" Margin="0,3,10,3">
                                  <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="brd" Value="{DynamicResource Bright2.Transparent.Background}"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                  </Trigger>
                                  <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" TargetName="brd" Value="{DynamicResource Bright2.Transparent.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="brd" Value="Gold"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ListBox.Resources>
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <!--<TextBlock Text="{Binding TimeTableName}" TextAlignment="Center"/>-->
                          <TextBlock Text="{Binding TimeTableName}" TextAlignment="Center" ToolTip="{Binding TimeTableName}">
                            <TextBlock.Resources>
                              <Style TargetType="{x:Type ToolTip}">
                                <Setter Property="Template">
                                  <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToolTip}">
                                      <Border Background="{DynamicResource Bright.Transparent.Background}" BorderBrush="Gold" BorderThickness="1" CornerRadius="6" Padding="3">
                                        <StackPanel>
                                          <TextBlock Foreground="Black" FontWeight="Bold" Text="{Binding TimeTableName}"/>
                                          <TextBlock Foreground="Black" Text="{Binding Hint}"/>
                                        </StackPanel>
                                      </Border>
                                    </ControlTemplate>
                                  </Setter.Value>
                                </Setter>
                              </Style>
                            </TextBlock.Resources>
                    </TextBlock>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </WrapPanel>
                </Expander>
                <!--</GroupBox>-->

                <!-- **** La-Nummern Liste **** -->
                <Expander Header="Fahrpläne" IsExpanded="True" Margin="1" Grid.Row="2" Visibility="{Binding LaNumberList.Count, ConverterParameter=0, Converter={StaticResource CountToVisibilityConverter}, Mode=OneWay}">
                    <Expander.Style>
                    <Style TargetType="Expander">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Expander">
                            <GroupBox Header="La-Strecken" Foreground="White" BorderThickness="1" BorderBrush="WhiteSmoke" Grid.Row="1" Margin="1,0,1,1">
                              <WrapPanel Orientation="Horizontal">
                                <!-- Header mit Toggle -->
                                <ToggleButton
                              Style="{StaticResource TrainViewExpanderButtonStyle}"
                              Content="{TemplateBinding Header}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                              FontWeight="Bold"
                              Background="LightGray"
                              BorderThickness="0"
                              Padding="5" VerticalAlignment="Top"/>
                                <!-- Inhalt -->
                                <ContentPresenter Visibility="{TemplateBinding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Margin="5"/>
                              </WrapPanel>
                            </GroupBox>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </Expander.Style>

                  <!--<GroupBox Header="La-Strecken" Foreground="White"  Visibility="{Binding LaNumberList.Count, ConverterParameter=0, Converter={StaticResource CountToVisibilityConverter}, Mode=OneWay}" BorderThickness="1" BorderBrush="WhiteSmoke" Grid.Row="2" Margin="1,1,1,2">-->
                    <StackPanel Orientation="Horizontal">

                      <ListBox x:Name="ListLaNrs" ItemsSource="{Binding LaNumberList}" SelectedItem="{Binding SelectedLaNumber}" IsSynchronizedWithCurrentItem="True" Background="{x:Null}"
                    SelectionChanged="SelectedLaNumberChanged" BorderThickness="0">
                        <ListBox.Resources>
                          <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Generic.Foreground}"/>
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                  <Border x:Name="brd" Background="blue" BorderBrush="White" BorderThickness="1" CornerRadius="0" Padding="3" Margin="0,3,10,3">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                  </Border>
                                  <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                      <Setter Property="Background" TargetName="brd" Value="{DynamicResource Bright2.Transparent.Background}"/>
                                      <Setter Property="Foreground" Value="Gray"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                      <Setter Property="Background" TargetName="brd" Value="{DynamicResource Bright2.Transparent.Background}"/>
                                      <Setter Property="BorderBrush" TargetName="brd" Value="Gold"/>
                                      <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </ListBox.Resources>
                        <ListBox.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                          </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                      </ListBox>
                    </StackPanel>
                  <!--</GroupBox>-->
                </Expander>
              </Grid>
              <!--<cef:ChromiumWebBrowser Width="auto" Address="{Binding SelectedTimeTableRelation.Address, Mode=OneWay}"/>-->
              <Grid>
                <GroupBox Header="Information" Foreground="White" BorderThickness="1" BorderBrush="WhiteSmoke" Grid.Row="1" Margin="1,0,1,1">

                  <!-- ***** Doku Tabcontrol ****-->
                  <TabControl ContentTemplateSelector="{StaticResource TabSelector}" ItemsSource="{Binding Tabs}" SelectionChanged="TabControl_SelectionChanged2" Grid.Row="0">
                    <TabControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                      </DataTemplate>
                    </TabControl.ItemTemplate>
                  </TabControl>
                </GroupBox>




