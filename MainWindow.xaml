                        </TextBox>
                      </StackPanel>
                    </Grid>
                    <Grid>
                      <Border x:Name="ZSK_Border" SizeChanged="ZSK_Border_SizeChanged">
                        <WpF:WebView2 x:Name="webView_ZSK" />
                      </Border>
                    </Grid>
                  </DockPanel>
