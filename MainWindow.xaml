                        <Button Command="{x:Static local:MainWindow.ZSK_PositionOverlayCommand}" CommandTarget="{Binding ElementName=window}" Content="Overlay" HorizontalAlignment="Right" Style="{DynamicResource ZusiStartButtonStyle}" Visibility="Visible" Width="80"/>
