<Window x:Class="ZusiStart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZusiStart"
        xmlns:cv="clr-namespace:ZusiStart.Converter"
        xmlns:ctrls="clr-namespace:ZusiStart.Controls" 
        xmlns:data="clr-namespace:ZusiStart.Data"
        xmlns:zg="clr-namespace:ZusiMeterGaugesLib.Gauges;assembly=ZusiMeterGaugesLib"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:s="clr-namespace:Sovoma;assembly=Sovoma"
        xmlns:WpF="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        x:Name="window" 
        Background="{DynamicResource bkgnd0}"
        MinWidth="1500"
        MinHeight="700"
        DataContext="{Binding Source={x:Static data:DataManager.Instance}}"
        Title="Zusi • Fahrplanauswahl" SnapsToDevicePixels="True" UseLayoutRounding="True" 
        ResizeMode="CanResize" 
        WindowStyle="SingleBorderWindow"
        WindowState="Normal" 
        Icon="zusistart.ico">

  <Window.Resources>
    <cv:EpocheToStringConverter x:Key="EpocheToStringConverter"/>
    <cv:ColWidthConverter x:Key="ColWidthConverter"/>
    <cv:GridSizeConverter x:Key="GridSizeConverter"/>
    <cv:TimeTableRelationConverter x:Key="TimeTableRelationConverter"/>

    <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="brd" Padding="0" CornerRadius="6" BorderThickness="2">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="brd" Property="BorderBrush" Value="Gold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <CollectionViewSource x:Key="PassengerTrains" Source="{Binding TimeTableTrains}" Filter="PassengerTrains_Filter"/>
    <CollectionViewSource x:Key="FreightTrains" Source="{Binding TimeTableTrains}" Filter="FreightTrains_Filter"/>
    <CollectionViewSource x:Key="FoundPassengerTrains" Source="{Binding FoundTrains}" Filter="PassengerTrains_Filter"/>
    <CollectionViewSource x:Key="FoundFreightTrains" Source="{Binding FoundTrains}" Filter="FreightTrains_Filter"/>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="auto"/>
    </Grid.RowDefinitions>
    <Menu Grid.Row="0" VerticalAlignment="Top" Grid.ColumnSpan="2" DockPanel.Dock="Top" Padding="0,0" Visibility="Visible"
>
      <Control.Background>
        <LinearGradientBrush>
          <GradientStop Offset="0" Color="#FF76A8FF"/>
          <GradientStop Offset="1" Color="#FF6A9BF3"/>
        </LinearGradientBrush>
      </Control.Background>
      <MenuItem Header="_Einstellungen">
        <MenuItem Command="{x:Static local:MainWindow.CommandOptions}" CommandTarget="{Binding ElementName=mainWindow}"/>
      </MenuItem>
      <MenuItem Header="_Info">
        <MenuItem Command="{x:Static local:MainWindow.CommandAbout}" CommandTarget="{Binding ElementName=mainWindow}"/>
        <MenuItem Command="{x:Static local:MainWindow.CommandHelp}" CommandTarget="{Binding ElementName=mainWindow}"/>
        <MenuItem Command="{x:Static local:MainWindow.CommandExtDocu}" CommandTarget="{Binding ElementName=mainWindow}"/>
      </MenuItem>
    </Menu>
    <Rectangle x:Name="rctMask" Fill="Black" Opacity="0.66" IsHitTestVisible="False" Panel.ZIndex="2" Visibility="Visible" d:IsHidden="True"/>
    <!--<StackPanel Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1" Orientation="Horizontal">
      <Button Margin="0,0,6,0" Command="{x:Static local:MainWindow.MinimizeCommand}" Style="{DynamicResource ZusiStartMinimizeButtonStyle}"/>
      <Button Command="{x:Static local:MainWindow.ExitGameCommand}" Style="{DynamicResource ZusiStartExitGameButtonStyle}"/>
    </StackPanel>-->
    <Grid x:Name="mainGrid" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="21*"/>
        <RowDefinition Height="202*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <!--<Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>-->
      <!-- =================================== Version/Copyright =================================== -->
      <!--<Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,180,0" Visibility="{Binding VersionVisibility, ElementName=window}" Padding="12" CornerRadius="12" Background="#0E242522"
                    MouseEnter="VersionPanel_MouseEnter">
        <StackPanel>
          <TextBlock Text="Zusi • Zugauswahl" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource LightGhostTextColorKey}" FontStyle="Italic" HorizontalAlignment="Center"/>
          <TextBlock FontSize="14" Foreground="{DynamicResource GhostTextColorKey}" FontStyle="Italic" HorizontalAlignment="Center">
                    <Run>Version</Run>
                    <Run Text="{Binding Source={x:Static s:AsmInfo.Version}, Converter={StaticResource VersionStringConverter}, ConverterParameter=%V, Mode=OneWay}"/>
          </TextBlock>
          <TextBlock FontSize="14" Foreground="{DynamicResource GhostTextColorKey}" FontStyle="Italic" HorizontalAlignment="Center"
                               Text="{Binding Source={x:Static s:AsmInfo.Copyright}, Mode=OneWay}"/>
          <TextBlock FontSize="16" Foreground="{DynamicResource GhostTextColorKey}" FontStyle="Italic" HorizontalAlignment="Center" 
                               Text="{Binding Source={x:Static s:AsmInfo.SupportEMail}, Mode=OneWay}"/>
          -->
      <!-- ab 0.9.6 -->
      <!--
          <TextBlock FontSize="14" Foreground="{DynamicResource GhostTextColorKey}" FontStyle="Italic" HorizontalAlignment="Center"
                           Text="Ignoramus, ignarobimus"/>
        </StackPanel>
      </Border>-->
      <!-- ==================================== Fahrplanauswahl ==================================== -->
      <Border x:Name="brdMain" Visibility="{Binding MainBorderVisibility, ElementName=window}" Panel.ZIndex="1" d:IsHidden="True" Grid.RowSpan="2">
      <!--<Border x:Name="brdMain" Visibility="Visible" Panel.ZIndex="1" d:IsHidden="True" Grid.RowSpan="2">-->
        <Grid Cursor="">
          <Grid.ColumnDefinitions>
            <!--<ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="768"/>
            <ColumnDefinition Width="6*"/>-->
            <ColumnDefinition Width="500" MinWidth="500"/>
            <ColumnDefinition Width="768*" MinWidth="768"/>
            <ColumnDefinition Width="auto" MinWidth="500"/>
          </Grid.ColumnDefinitions>
          <GridSplitter Grid.Column="0" Background="Black" Width="5"/>
          <GridSplitter Grid.Column="1" Background="Black" Width="5" Cursor="SizeWE"/>
          <Border x:Name="brdTimeTables" Background="{DynamicResource Blue.Transparent.Background}" CornerRadius="6" Margin="0,0,3,0" Padding="3">
            <ListBox BorderThickness="0" Background="{x:Null}" IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding GroupedTimeTables}" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Visible" 
                                 HorizontalContentAlignment="Center" 
                                 ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                                 PreviewGotKeyboardFocus="ListBox_PreviewGotKeyboardFocus">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <ctrls:TimeTableOverviewControl x:Name="toc" Source="{Binding}" SelectedTimeTableChanged="TimeTableOverviewControl_SelectedTimeTableChanged"
                                                                    IsSelected="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Mode=TwoWay}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Border x:Name="brdBrowser" Grid.Column="1" Background="{DynamicResource Blue.Transparent.Background}" Margin="3,0" CornerRadius="6" Padding="6"
                            Visibility="{Binding SelectedTimeTableRelation, ConverterParameter={x:Static Visibility.Hidden}, Converter={StaticResource TimeTableRelationConverter}}">
            <DockPanel>
              <ListBox 
                                     ItemsSource="{Binding Relations}"
                                     SelectedItem="{Binding SelectedTimeTableRelation}"
                                     BorderThickness="0" 
                                     Margin="0,0,0,3"
                                     Background="{x:Null}" 
                                     DockPanel.Dock="Top" 
                                     IsSynchronizedWithCurrentItem="True"
                                     Visibility="{Binding Relations.Count, ConverterParameter=1, Converter={StaticResource CountToVisibilityConverter}, Mode=OneWay}">
                <ListBox.Resources>
                  <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Background" Value="{x:Null}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Generic.Foreground}"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                          <Border x:Name="brd" Background="{x:Null}" BorderBrush="White" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,6,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="Background" TargetName="brd" Value="{DynamicResource Bright2.Transparent.Background}"/>
                              <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter Property="Background" TargetName="brd" Value="{DynamicResource Bright2.Transparent.Background}"/>
                              <Setter Property="BorderBrush" TargetName="brd" Value="Gold"/>
                              <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.Resources>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Index}" MinWidth="30" TextAlignment="Center" ToolTip="{Binding TimeTableName}">
                      <TextBlock.Resources>
                        <Style TargetType="{x:Type ToolTip}">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="{x:Type ToolTip}">
                                <Border Background="{DynamicResource Bright.Transparent.Background}" BorderBrush="Gold" BorderThickness="1" CornerRadius="6" Padding="3">
                                  <StackPanel>
                                    <TextBlock Foreground="Black" FontWeight="Bold" Text="{Binding TimeTableName}"/>
                                    <TextBlock Foreground="Black" Text="{Binding Hint}"/>
                                  </StackPanel>
                                </Border>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </TextBlock.Resources>
                    </TextBlock>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <!--<cef:ChromiumWebBrowser Width="auto" Address="{Binding SelectedTimeTableRelation.Address, Mode=OneWay}"/>-->
              <WpF:WebView2 x:Name="webView" Width="768"/>  <!--Source="{Binding SelectedTimeTableRelation.Begruessungsdatei}"/>-->
            </DockPanel>
          </Border>
          <!-- Anzeige der Züge -->
          <!--<Border x:Name="brdTrains" BorderThickness="0" Background="{DynamicResource Blue.Transparent.Background}" CornerRadius="6" Grid.Column="2" Margin="3,0,0,0" Padding="3"
                            Visibility="{Binding TimeTableTrains.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=0}">-->
          <Border x:Name="brdTrains" BorderThickness="0" Background="{DynamicResource Blue.Transparent.Background}" CornerRadius="6" Grid.Column="2" Margin="3,0,0,0" Padding="3"
                  Visibility="Visible">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition>
                  <ColumnDefinition.Width>
                    <MultiBinding Converter="{StaticResource GridSizeConverter}" ConverterParameter="0">
                      <Binding Path="ItemsSource.Count" ElementName="tvPassengerTrains"/>
                      <Binding Path="ItemsSource.Count" ElementName="tvFreightTrains"/>
                    </MultiBinding>
                  </ColumnDefinition.Width>
                </ColumnDefinition>
                <ColumnDefinition>
                  <ColumnDefinition.Width>
                    <MultiBinding Converter="{StaticResource GridSizeConverter}" ConverterParameter="1">
                      <Binding Path="ItemsSource.Count" ElementName="tvPassengerTrains"/>
                      <Binding Path="ItemsSource.Count" ElementName="tvFreightTrains"/>
                    </MultiBinding>
                  </ColumnDefinition.Width>
                </ColumnDefinition>
              </Grid.ColumnDefinitions>
              
              <ctrls:TrainsView x:Name="tvPassengerTrains"
                                      ItemsSource="{Binding Source={StaticResource PassengerTrains}}" 
                                      Margin="0,0,3,0" 
                                      Style="{StaticResource TrainViewStyle}"
                                      SelectedItemChanged="TreeView_SelectedItemChanged"/>
              <ctrls:TrainsView x:Name="tvFreightTrains"
                                      Grid.Column="1" 
                                      ItemsSource="{Binding Source={StaticResource FreightTrains}}" 
                                      Margin="3,0,0,0" 
                                      Style="{StaticResource TrainViewStyle}"
                                      SelectedItemChanged="TreeView_SelectedItemChanged"
                                      Visibility="{Binding ItemsSource.Count, RelativeSource={RelativeSource Self}, 
                                                   Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=0}"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <!-- ==================================== Zugsuche ==================================== -->
      <Border VerticalAlignment="Top" Grid.Row="1" x:Name="brdSearch" Visibility="{Binding SearchBorderVisibility, ElementName=window}" Panel.ZIndex="1" d:IsHidden="True" Grid.RowSpan="2">
        <Grid VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.350*"/>
            <ColumnDefinition Width="0.281*"/>
            <ColumnDefinition Width="0.369*"/>
          </Grid.ColumnDefinitions>
          <!-- Spalte 0: Fahrzeugauswahl -->
          <Grid VerticalAlignment="Top" Height="208" Margin="0,0,3,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*"/>
              <ColumnDefinition Width="3*"/>
              <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="6" Padding="3" Background="{DynamicResource Blue.Transparent.Background}">
              <Grid>
                <Label Content="Traktion" Foreground="AntiqueWhite" HorizontalAlignment="Center" FontSize="14" VerticalAlignment="Top"/>
                <zg:Knob HorizontalAlignment="Center" VerticalAlignment="Center" SelectedNotch="{Binding TractionKind, Mode=TwoWay}"
                                         LockedLabelBrush="Gray" SelectedLabelBrush="GreenYellow">
                  <zg:Knob.Notches>
                    <zg:Notch Label="beliebig"/>
                    <zg:Notch Label="Dampf"/>
                    <zg:Notch Label="Diesel"/>
                    <zg:Notch Label="Elektrisch"/>
                    <zg:Notch Label="Akku"/>
                  </zg:Knob.Notches>
                </zg:Knob>
              </Grid>
            </Border>
            <Border Grid.Column="1" CornerRadius="6" Padding="3" Background="{DynamicResource Blue.Transparent.Background}" Margin="6,0,0,0">
              <Grid>
                <Label Content="Fahrzeugart" Foreground="AntiqueWhite" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="14"/>
                <zg:Knob HorizontalAlignment="Center" VerticalAlignment="Center" SelectedNotch="{Binding TrainKind, Mode=TwoWay}" Notches="{Binding TrainKindNotches}"
                                         LockedLabelBrush="Gray" SelectedLabelBrush="GreenYellow"/>
              </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="6" Padding="3" Background="{DynamicResource Blue.Transparent.Background}" Margin="6,0,0,0">
              <Grid>
                <Label Content="Epoche" Foreground="AntiqueWhite" HorizontalAlignment="Center" FontSize="14" VerticalAlignment="Top"/>
                <zg:Knob x:Name="knobEpoche" HorizontalAlignment="Center" VerticalAlignment="Center" SelectedNotch="{Binding Epoche, Mode=TwoWay}"
                                     SelectedLabelBrush="GreenYellow">
                  <zg:Knob.Notches>
                    <zg:Notch Label="beliebig"/>
                    <zg:Notch Label="I"/>
                    <zg:Notch Label="II"/>
                    <zg:Notch Label="III"/>
                    <zg:Notch Label="IV"/>
                    <zg:Notch Label="V"/>
                    <zg:Notch Label="VI"/>
                  </zg:Knob.Notches>
                </zg:Knob>
                <TextBlock Foreground="AntiqueWhite" HorizontalAlignment="Center" VerticalAlignment="Bottom" Text="{Binding SelectedNotch, ElementName=knobEpoche, Converter={StaticResource EpocheToStringConverter}}"/>
              </Grid>
            </Border>
          </Grid>
          <Border Grid.Row="1" CornerRadius="6" Background="{DynamicResource Blue.Transparent.Background}" Padding="3" Margin="0,3,3,0">
            <ListBox Background="{x:Null}" IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding FilteredVehicles, Mode=OneWay}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                 ItemContainerStyle="{DynamicResource ListBoxItemStyle}" BorderThickness="0"
                                 SelectedItem="{Binding CurrentVehicleContainer}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="6" Background="{DynamicResource Bright.Transparent.Background}" Padding="3">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                      </Grid.ColumnDefinitions>

                      <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                      </Grid.RowDefinitions>                        
                        
                      <Label Content="{Binding DisplayName}" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,-20"/>
                      <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                          <!--<ColumnDefinition Width="{Binding Sources[1], Converter={StaticResource ColWidthConverter}}"/>-->
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Sources[0]}" Stretch="None" Margin="{Binding Margins[0]}"/>
                        <!--<Image Grid.Column="1" Source="{Binding Sources[1]}" Stretch="None" Margin="{Binding Margins[1]}" 
                                                       Visibility="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>-->
                        <Image Grid.Column="1" Source="{Binding Sources[1]}" Stretch="None" Margin="{Binding Margins[1]}" 
                               Visibility="Visible"/>
                        <!--<Image Grid.Column="2" Source="{Binding Sources[2]}" Stretch="None" Margin="{Binding Margins[2]}"
                                                       Visibility="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>-->
                        <Image Grid.Column="2" Source="{Binding Sources[2]}" Stretch="None" Margin="{Binding Margins[2]}"
                               Visibility="Visible"/>
                        
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <!-- Spalte 1: Suche nach konkreter Zugnummer -->
          <Border Grid.Column="1" CornerRadius="6" Margin="3,0,3,3" Background="{StaticResource Blue.Transparent.Background}" Padding="3">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Text="Einen Zug anhand der Zugnummer suchen" Foreground="AntiqueWhite" FontSize="14" HorizontalAlignment="Center" Padding="0,5,0,0"/>
              <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="12" 
                                       Foreground="WhiteSmoke">
                                Im Suchfeld ist mindestens die Zugnummer anzugeben. Optional kann auch die Gattung angegeben werden (z.B. ERB1234). Leerzeichen zwischen
                                Gattung und Nummer können weggelassen werden. Es wird nicht zwischen Groß- und Kleinschreibung unterschieden.
              </TextBlock>
              <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Label Grid.Row="2" Content="Suchen nach" VerticalAlignment="Center" HorizontalContentAlignment="Right" Foreground="White" Margin="0,0,6,0" FontSize="14"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <ctrls:SearchTextBox x:Name="tbxTrainNumber" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="99" Width="100" GotFocus="TbxTrainNumber_GotFocus" FontSize="14" TextChanged="TbxTrainNumber_TextChanged"/>
                  <Button Command="{x:Static local:MainWindow.SearchTrainCommand}" Grid.Column="2" HorizontalAlignment="Center" 
                                            Content="{Binding Command.Text, RelativeSource={RelativeSource Self}}" Style="{DynamicResource ZusiStartButtonStyle}" IsDefault="True" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
              <TextBlock x:Name="tblkMessage" Grid.Row="3" Grid.ColumnSpan="2" Foreground="#FFFF9C00" HorizontalAlignment="Center" Text="Zug nicht gefunden" VerticalAlignment="Top" Margin="0,12,0,0" Visibility="Hidden"/>
            </Grid>
          </Border>
          <!-- Spalte 1: Anzeige der möglichen Fahrpläne -->
          <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource Blue.Transparent.Background}" CornerRadius="6" Margin="3,3,3,0" Padding="3">
            <TreeView BorderThickness="0" ItemsSource="{Binding FoundTimeTables, Mode=OneWay}" SelectedItemChanged="FoundTimeTableTreeView_SelectedItemChanged" Background="{x:Null}">
              <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}">
                  <Setter Property="Foreground" Value="{DynamicResource Generic.Foreground}"/>
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBold}" Value="True">
                      <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsBold}" Value="False">
                      <Setter Property="FontWeight" Value="Normal"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children, Mode=OneWay}">
                  <ContentPresenter Content="{Binding DisplayName}" Margin="2"/>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Border>

          <!-- Spalte 3: Anzeige der möglichen Züge -->
          <!--<Border Grid.Column="2" Grid.RowSpan="2" Background="{DynamicResource Blue.Transparent.Background}" CornerRadius="6" Margin="3,0,0,0" Padding="3"
                            Visibility="{Binding FoundTrains.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=0}">-->
          <Border Grid.Column="2" Grid.RowSpan="2" Background="{DynamicResource Blue.Transparent.Background}" CornerRadius="6" Margin="3,0,0,0" Padding="3"
                   Visibility="Visible">

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition>
                  <ColumnDefinition.Width>
                    <MultiBinding Converter="{StaticResource GridSizeConverter}" ConverterParameter="0">
                      <Binding Path="ItemsSource.Count" ElementName="tvFoundPassengerTrains"/>
                      <Binding Path="ItemsSource.Count" ElementName="tvFoundFreightTrains"/>
                    </MultiBinding>
                  </ColumnDefinition.Width>
                </ColumnDefinition>
                <ColumnDefinition>
                  <ColumnDefinition.Width>
                    <MultiBinding Converter="{StaticResource GridSizeConverter}" ConverterParameter="1">
                      <Binding Path="ItemsSource.Count" ElementName="tvFoundPassengerTrains"/>
                      <Binding Path="ItemsSource.Count" ElementName="tvFoundFreightTrains"/>
                    </MultiBinding>
                  </ColumnDefinition.Width>
                </ColumnDefinition>
              </Grid.ColumnDefinitions>
              <ctrls:TrainsView x:Name="tvFoundPassengerTrains"
                                              ItemsSource="{Binding Source={StaticResource FoundPassengerTrains}}" 
                                              Margin="0,0,3,0" 
                                              Style="{StaticResource TrainViewStyle}"
                                              SelectedItemChanged="FoundTrainTreeView_SelectedItemChanged"/>
              <ctrls:TrainsView x:Name="tvFoundFreightTrains"
                                              Grid.Column="1"
                                              ItemsSource="{Binding Source={StaticResource FoundFreightTrains}}" 
                                              Margin="3,0,0,0" 
                                              Style="{StaticResource TrainViewStyle}"
                                              SelectedItemChanged="FoundTrainTreeView_SelectedItemChanged"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <!-- ==================================== ausgewählter Zug ==================================== -->
      <!--<ctrls:TimeTableInfoControl Grid.Row="1" Source="{Binding CurrentTrain, Mode=OneWay}" Margin="0,6,0,0" 
                                        Visibility="{Binding CurrentTrain, Converter={StaticResource NullToVisibilityConverter},ConverterParameter=Visibility.Visible, Mode=OneWay}"/>-->
      <!--<ctrls:TimeTableInfoControl Grid.Row="2" Source="{Binding CurrentTrain, Mode=OneWay}" Margin="0,6,0,0" 
                            Visibility="Visible"/>-->

      <!-- ================================= zuletzt gefahrene Züge ================================= -->
      <Border  Grid.Row="1"  x:Name="brdRecent" Panel.ZIndex="1" Background="{DynamicResource Blue.Transparent.Background}" CornerRadius="6" Padding="0,1,0,3"
                    Visibility="{Binding RecentTrainsBorderVisibility, ElementName=window}" d:IsHidden="True" Grid.RowSpan="2">
        <ListBox BorderThickness="0" Background="Transparent"
                         ItemsSource="{Binding RecentTrains}"
                         SelectedItem="{Binding SelectedRecentTrain}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Resources>
            <Style TargetType="{x:Type ListBoxItem}">
              <Setter Property="Background" Value="{DynamicResource Bright.Transparent.Background}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="brd" BorderBrush="{DynamicResource Blue.Transparent.Background}" BorderThickness="1" CornerRadius="6" Padding="0" Margin="2,0,2,3">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" TargetName="brd" Value="{DynamicResource Bright2.Transparent.Background}"/>
                        <Setter Property="BorderBrush" TargetName="brd" Value="Gold"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" TargetName="brd" Value="{DynamicResource Bright2.Transparent.Background}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.Resources>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <ctrls:TimeTableInfoControl Source="{Binding Train}" UseCounter="{Binding Used}" TimeTableName="{Binding TimeTableName}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <!-- ================================= Gleisbedingungen ======================================= -->
      <Popup Placement="Top" PlacementTarget="{Binding ElementName=frictionSettingsButton, Mode=OneWay}" PopupAnimation="Fade" AllowsTransparency="True" IsOpen="{Binding FrictionSettingsPopupVisible, ElementName=window}" Grid.RowSpan="2">
        <Border x:Name="brdFrictionSettings" CornerRadius="6" Padding="3" Background="{DynamicResource Blue.Transparent.Background}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="200" Height="200" Margin="0,0,743,0" 
                        Panel.ZIndex="2" BorderBrush="Goldenrod" BorderThickness="1">
          <Border.Effect>
            <DropShadowEffect/>
          </Border.Effect>
          <DockPanel>
            <Label Content="Gleisbedingungen" Foreground="AntiqueWhite" HorizontalAlignment="Center" FontSize="14" VerticalAlignment="Top" DockPanel.Dock="Top"/>
            <zg:Knob VerticalAlignment="Center" HorizontalAlignment="Center" KnobSize="60" SelectedLabelBrush="GreenYellow" SelectedNotch="{Binding FrictionPreset, Mode=TwoWay, Converter={StaticResource FrictionPresetConverter}}">
              <zg:Knob.Notches>
                <zg:Notch Label="trocken"/>
                <zg:Notch Label="naß"/>
                <zg:Notch Label="neblig"/>
                <zg:Notch Label="vereist"/>
              </zg:Knob.Notches>
            </zg:Knob>
          </DockPanel>
        </Border>
      </Popup>
      
    </Grid>
    <ctrls:TimeTableInfoControl Grid.Row="2" Source="{Binding CurrentTrain, Mode=OneWay}" Margin="0,6,0,0" 
                      Visibility="Visible"/>
    <!-- ==================================== Statuszeile ==================================== -->
    <DockPanel Grid.Row="3" Margin="0,6,6,0" Visibility="{Binding StatusBarVisibility, ElementName=window}" Width="auto">
      <StackPanel Orientation="Horizontal" Width="auto">
        <Border Background="#54000000" CornerRadius="6" Padding="3" HorizontalAlignment="Left">
          <TextBlock Padding="5,7,3,6" Foreground="{DynamicResource Generic.Dark.Foreground}">
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource StringFormatMultiConverter}" ConverterParameter="Insgesamt stehen {0} Personen-|_und {0} Güter[zug:züge]|_in {0} Fahr[plan:plänen] zur Auswahl." Mode="OneWay">
                <Binding Path="CountWindowTrains"/>
                <Binding Path="CountFreightTrains"/>
                <Binding Path="CountTimeTables"/>
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </Border>
        <!--
              <ctrls:UpdateControl x:Name="updater" Margin="24,0,0,0" ButtonStyle="{DynamicResource ZusiStartButtonStyle}" AutoUpdateChanged="Updater_AutoUpdateChanged" Visibility="Hidden"/>
              -->
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <!-- Deko-Züge ein/aus -->
        <ToggleButton IsChecked="{Binding IsDecoTrainsAllowed}" VerticalAlignment="Center" Content="Dekozüge anzeigen" Margin="24,0,0,0" Style="{StaticResource DecoTrainsButtonStyle}" Checked="ToggleButton_Checked"/>
        <!-- Einstellungen -->
        <Button VerticalAlignment="Center" Command="{x:Static local:MainWindow.TrainStartSettingsCommand}" Content="{Binding Command.Text, RelativeSource={RelativeSource Self}}" Margin="24,0,0,0" Style="{DynamicResource ZusiStartButtonStyle}"/>
        <!-- Gleisbedingungen -->
        <Button x:Name="frictionSettingsButton" VerticalAlignment="Center" Command="{x:Static local:MainWindow.FrictionSettingsCommand}" Content="{Binding Command.Text, RelativeSource={RelativeSource Self}}" Margin="6,0,24,0" Style="{DynamicResource ZusiStartButtonStyle}"/>
        <ctrls:MultiButtonControl>
          <ctrls:MultiButtonControl.Items>
            <ctrls:MultiButtonItem Command="{x:Static local:MainWindow.TimeTablesPageCommand}" CommandTarget="{Binding ElementName=window}" Header="{Binding Command.Text, RelativeSource={RelativeSource Self}}" IsFirst="True" IsSelected="True"/>
            <ctrls:MultiButtonItem Command="{x:Static local:MainWindow.SearchPageCommand}" CommandTarget="{Binding ElementName=window}" Header="{Binding Command.Text, RelativeSource={RelativeSource Self}}"/>
            <ctrls:MultiButtonItem Command="{x:Static local:MainWindow.RecentTrainsPageCommand}" CommandTarget="{Binding ElementName=window}" Header="{Binding Command.Text, RelativeSource={RelativeSource Self}}" IsLast="True"/>
          </ctrls:MultiButtonControl.Items>
        </ctrls:MultiButtonControl>
        <Button Command="{x:Static local:MainWindow.StartTrainCommand}" Content="{Binding Command.Text, RelativeSource={RelativeSource Self}}" Style="{DynamicResource ZusiStartHiddenButtonStyle}" Margin="12,0,0,0"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
